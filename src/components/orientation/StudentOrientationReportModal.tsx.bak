"use client"

import React, { useRef, useState, useEffect } from "react"
import {
  X,
  Printer,
  Download,
  HeartHandshake,
  UserCheck,
  Users,
  Compass,
  CheckCircle2,
  AlertCircle,
  Sparkles,
  BookOpen,
  Award,
  ShieldCheck,
  RefreshCw,
  Calendar,
  Brain,
  Phone,
  MapPin,
  User,
  Clock,
  Mail,
  GraduationCap,
  FileText
} from "lucide-react"

interface StudentOrientationReportModalProps {
  isOpen: boolean
  onClose: () => void
  student: any
  orientationData?: any
}

export function StudentOrientationReportModal({
  isOpen,
  onClose,
  student,
  orientationData: propOrientationData
}: StudentOrientationReportModalProps) {
  const printRef = useRef<HTMLDivElement>(null)
  const [loading, setLoading] = useState(false)
  const [exportingPdf, setExportingPdf] = useState(false)
  const [orientationData, setOrientationData] = useState<any>(propOrientationData || null)

  // Khởi tạo và fetch dữ liệu nhanh chóng, không làm đơ giao diện
  useEffect(() => {
    if (!isOpen || !student?.id) return

    // 1. Ưu tiên dữ liệu có sẵn ngay lập tức từ props hoặc từ học sinh
    const initialData = propOrientationData || student?.orientationRecord || student?.orientationData
    if (initialData) {
      setOrientationData(initialData)
      setLoading(false)
    } else {
      setLoading(true)
    }

    let isMounted = true

    // Thiết lập timeout an toàn 1.2s
    const timer = setTimeout(() => {
      if (isMounted) setLoading(false)
    }, 1200)

    fetch(`/api/admin/orientation/records?studentId=${student.id}`)
      .then(res => res.json())
      .then(data => {
        if (isMounted) {
          if (data.success && data.data) {
            setOrientationData(data.data)
          } else if (!orientationData && (student?.orientationRecord || initialData)) {
            setOrientationData(student.orientationRecord || initialData)
          }
        }
      })
      .catch(err => {
        console.error("Lỗi tải bản ghi định hướng:", err)
      })
      .finally(() => {
        if (isMounted) setLoading(false)
      })

    return () => {
      isMounted = false
      clearTimeout(timer)
    }
  }, [isOpen, student?.id, propOrientationData])

  if (!isOpen) return null

  // Xuất file PDF hoặc In A4 chuẩn đa trang (Multi-page) thông qua Isolated Print Frame
  const handlePrintOrExport = (isPdfDownload = false) => {
    try {
      if (isPdfDownload) setExportingPdf(true)
      const cleanName = (student?.fullName || "HocSinh")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-zA-Z0-9\s]/g, "")
        .trim()
        .replace(/\s+/g, "_")
      const code = student?.studentCode || "KSDV"
      const pdfTitle = `Phieu_Dinh_Huong_${cleanName}_${code}`

      const printElement = document.getElementById("orientation-report-printable")
      if (!printElement) {
        window.print()
        if (isPdfDownload) setExportingPdf(false)
        return
      }

      // Xóa thẻ clone fallback cũ nếu có
      const oldDirect = document.getElementById("direct-print-root")
      if (oldDirect) oldDirect.remove()

      // Tạo thẻ clone trực tiếp trên document.body để đảm bảo 100% không bao giờ trắng trang
      const directRoot = document.createElement("div")
      directRoot.id = "direct-print-root"
      directRoot.innerHTML = printElement.innerHTML
      document.body.appendChild(directRoot)

      // 1. Xóa iframe in cũ nếu có
      const oldIframe = document.getElementById("skyline-orientation-print-frame")
      if (oldIframe && oldIframe.parentNode) {
        oldIframe.parentNode.removeChild(oldIframe)
      }

      // 2. Tạo iframe với kích thước thật A4 ngoài màn hình để Chrome render đầy đủ layout (tránh lỗi width/height = 0 gây trắng trang)
      const iframe = document.createElement("iframe")
      iframe.id = "skyline-orientation-print-frame"
      iframe.style.position = "fixed"
      iframe.style.left = "-99999px"
      iframe.style.top = "0"
      iframe.style.width = "210mm"
      iframe.style.height = "297mm"
      iframe.style.border = "none"
      iframe.style.opacity = "0"
      iframe.style.pointerEvents = "none"
      iframe.style.zIndex = "-9999"
      document.body.appendChild(iframe)

      const iframeDoc = iframe.contentWindow?.document
      if (!iframeDoc) {
        // Fallback in trực tiếp nếu không lấy được iframe
        const originalTitle = document.title
        document.title = pdfTitle
        window.print()
        setTimeout(() => {
          document.title = originalTitle
          if (document.body.contains(directRoot)) directRoot.remove()
          if (isPdfDownload) setExportingPdf(false)
        }, 1200)
        return
      }

      // 3. Gom tất cả style và font từ document chính sang iframe
      const styles = Array.from(document.querySelectorAll("link[rel='stylesheet'], style"))
        .map(node => node.outerHTML)
        .join("\n")

      iframeDoc.open()
      iframeDoc.write(`
        <!DOCTYPE html>
        <html lang="vi">
          <head>
            <meta charset="utf-8">
            <title>${pdfTitle}</title>
            ${styles}
            <style>
              @page {
                size: A4 portrait;
                margin: 8mm 10mm 10mm 10mm;
              }
              * {
                box-sizing: border-box !important;
              }
              html, body {
                width: 100% !important;
                height: auto !important;
                min-height: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
                background: #ffffff !important;
                color: #0f172a !important;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                overflow: visible !important;
              }
              .print-container {
                width: 100% !important;
                max-width: 195mm !important;
                margin: 0 auto !important;
                padding: 0 !important;
                background: #ffffff !important;
              }
              .print-section {
                break-inside: avoid !important;
                page-break-inside: avoid !important;
                margin-bottom: 14px !important;
              }
              .print-page-break {
                break-before: page !important;
                page-break-before: always !important;
              }
              table {
                border-collapse: collapse !important;
                width: 100% !important;
              }
              tr {
                break-inside: avoid !important;
                page-break-inside: avoid !important;
              }
              .no-print {
                display: none !important;
              }
            </style>
          </head>
          <body>
            <div class="print-container">
              ${printElement.innerHTML}
            </div>
          </body>
        </html>
      `)
      iframeDoc.close()

      // Chờ iframe dựng xong font và layout rồi kích hoạt in đa trang
      setTimeout(() => {
        try {
          iframe.contentWindow?.focus()
          iframe.contentWindow?.print()
        } catch (e) {
          console.error("Lỗi gọi in iframe, fallback sang in trực tiếp:", e)
          const originalTitle = document.title
          document.title = pdfTitle
          window.print()
          setTimeout(() => {
            document.title = originalTitle
          }, 1000)
        } finally {
          setTimeout(() => {
            if (document.body.contains(iframe)) {
              document.body.removeChild(iframe)
            }
            if (document.body.contains(directRoot)) {
              directRoot.remove()
            }
            if (isPdfDownload) setExportingPdf(false)
          }, 1800)
        }
      }, 500)

    } catch (err: any) {
      console.error("Lỗi khi mở lệnh in:", err)
      if (isPdfDownload) setExportingPdf(false)
      window.print()
    }
  }

  // Parse phỏng vấn chi tiết (hỗ trợ cả cấu trúc Object 2026.1 và Mảng dữ liệu cũ)
  let interviewList: any[] = []
  let interviewVersion: string = "2026.1"
  let proposedPlacementRecommendation: string = ""
  let verificationInfo: any = null

  if (orientationData?.interviewData) {
    try {
      const parsed = typeof orientationData.interviewData === "string"
        ? JSON.parse(orientationData.interviewData)
        : orientationData.interviewData
      if (Array.isArray(parsed)) {
        interviewList = parsed
      } else if (parsed && typeof parsed === "object") {
        interviewList = Array.isArray(parsed.items) ? parsed.items : []
        interviewVersion = parsed.version || "2026.1"
        proposedPlacementRecommendation = parsed.proposedPlacementRecommendation || ""
        verificationInfo = parsed.verification || null
      }
    } catch (e) {
      console.warn("Lỗi parse interviewData:", e)
    }
  }

  if (!proposedPlacementRecommendation && orientationData?.proposedPlacementRecommendation) {
    proposedPlacementRecommendation = orientationData.proposedPlacementRecommendation
  }


  // Parse điểm môn học khảo sát thực tế tại Sky-Line (không lấy điểm học bạ, tách riêng môn tâm lý)
  const parseScores = () => {
    const res: Array<{ subject: string, score: string | number, remark?: string }> = []
    if (student?.scores && Array.isArray(student.scores)) {
      student.scores.forEach((sc: any) => {
        const subName = sc.subject?.name || sc.subjectName || "Môn khảo sát"
        const subCode = String(sc.subject?.code || "").toUpperCase()
        if (subCode === "TLY" || subCode.includes("TÂM LÝ") || subCode.includes("TAM LY")) return

        let scoreVal: any = sc.finalScore ?? sc.score ?? sc.scoreComposite ?? "-"
        if (sc.scores && typeof sc.scores === "string") {
          try {
            const arr = JSON.parse(sc.scores)
            if (Array.isArray(arr) && arr.length > 0) scoreVal = arr[arr.length - 1] ?? arr[0]
            else scoreVal = sc.scores
          } catch (e) {
            scoreVal = sc.scores
          }
        }
        res.push({
          subject: subName,
          score: scoreVal,
          remark: sc.remarks || sc.note || ""
        })
      })
    }

    // Bổ sung các môn khảo sát nhập nhanh từ Đánh giá Định hướng nếu chưa có
    const checkAndAdd = (name: string, val: any) => {
      if (val !== undefined && val !== null && val !== "") {
        const exists = res.some(r => r.subject.toLowerCase().includes(name.toLowerCase()))
        if (!exists) {
          res.push({
            subject: name,
            score: val,
            remark: "Nhập trực tiếp"
          })
        }
      }
    }

    checkAndAdd("Tiếng Anh (Viết)", orientationData?.writtenEnglishScore ?? student?.writtenEnglishScore)
    checkAndAdd("Tiếng Anh (Vấn đáp)", orientationData?.oralEnglishScore ?? student?.oralEnglishScore)
    checkAndAdd("Toán", orientationData?.mathScore ?? student?.mathScore)
    checkAndAdd("Ngữ văn", orientationData?.literatureScore ?? student?.literatureScore)

    return res
  }

  const subjectScores = parseScores()

  const ratingLabel = (rating: string) => {
    switch (rating) {
      case "CONFIDENT":
        return { label: "Tự tin / Tích cực", cls: "text-emerald-700 bg-emerald-50 border-emerald-200" }
      case "NORMAL":
        return { label: "Bình thường / Ổn định", cls: "text-sky-700 bg-sky-50 border-sky-200" }
      case "NEED_SUPPORT":
        return { label: "Cần hỗ trợ", cls: "text-amber-700 bg-amber-50 border-amber-200" }
      case "SPECIAL_ATTENTION":
        return { label: "Lưu ý đặc biệt", cls: "text-rose-700 bg-rose-50 border-rose-200" }
      default:
        return { label: "Ổn định", cls: "text-slate-700 bg-slate-50 border-slate-200" }
    }
  }

  const currentDateStr = new Date().toLocaleDateString("vi-VN", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric"
  })

  // Parse dữ liệu quyết định và chỉ đạo của GĐCS
  const gdcsData = React.useMemo(() => {
    const raw = orientationData?.admissionConsultantNote
    if (!raw) return null
    if (typeof raw === "string" && raw.trim().startsWith("{")) {
      try {
        return JSON.parse(raw)
      } catch (e) {
        return { gdcsGeneralNote: raw }
      }
    }
    return { gdcsGeneralNote: raw }
  }, [orientationData?.admissionConsultantNote])

  // Parse thông tin kiểm tra tâm lý & báo cáo từ GV Tâm lý
  const psychologyInfo = React.useMemo(() => {
    let pData: any = null
    if (orientationData?.psychologyData) {
      try {
        pData = typeof orientationData.psychologyData === "string" 
          ? JSON.parse(orientationData.psychologyData) 
          : orientationData.psychologyData
      } catch (e) {}
    }
    const status = orientationData?.psychologyReferralStatus || student?.psychologyReferralStatus
    const reason = orientationData?.psychologyReferralReason || student?.psychologyReferralReason || pData?.conclusion
    const teacherName = orientationData?.psychologyTeacherName || student?.psychologyTeacherName || pData?.reportedToGdcs?.reportedBy
    const score = orientationData?.psychologyScore ?? student?.psychologyScore ?? pData?.totalScore
    const hasIssue = status === "REQUESTED" || status === "COMPLETED" || !!reason || !!pData || (score !== undefined && score !== null)
    return {
      status,
      reason,
      teacherName,
      score,
      hasIssue,
      pData
    }
  }, [orientationData, student])

  return (
    <div id="orientation-report-modal-backdrop" className="no-print-backdrop fixed inset-0 z-[260] flex items-center justify-center p-2 sm:p-4 bg-slate-900/60 backdrop-blur-xs overflow-y-auto print:p-0 print:bg-white print:static print:z-auto">
      
      {/* SCREEN CONTAINER (A4 Wrapper) */}
      <div id="orientation-report-main-container" className="relative bg-white w-full max-w-[860px] rounded-3xl shadow-2xl border border-slate-200 flex flex-col max-h-[95vh] print:max-h-none print:h-auto print:border-none print:shadow-none print:rounded-none overflow-hidden">
        
        {/* TOP BAR (HIDDEN IN PRINT) */}
        <div className="no-print px-6 py-4 bg-slate-900 text-white flex items-center justify-between border-b border-slate-800 flex-shrink-0">
          <div className="flex items-center gap-3">
            <div className="w-8 h-8 rounded-xl bg-[#00A19A] text-white flex items-center justify-center">
              <Printer className="w-4 h-4" />
            </div>
            <div>
              <h3 className="text-sm font-black text-white">Báo Cáo Nhận Diện & Định Hướng Đầu Vào (Đầy Đủ Các Trang)</h3>
              <p className="text-[11px] text-slate-400 font-medium">Tự động ngắt trang tiêu chuẩn A4 • Gom đầy đủ 8 phần thông tin & chữ ký</p>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <button
              type="button"
              onClick={() => handlePrintOrExport(true)}
              disabled={exportingPdf || loading}
              className="flex items-center gap-1.5 px-4 py-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white rounded-xl text-xs font-black shadow-md cursor-pointer transition-all active:scale-[0.98] disabled:opacity-50"
            >
              {exportingPdf ? (
                <>
                  <RefreshCw className="w-4 h-4 animate-spin" />
                  <span>Đang chuẩn bị PDF...</span>
                </>
              ) : (
                <>
                  <Download className="w-4 h-4" />
                  <span>Xuất File PDF</span>
                </>
              )}
            </button>

            <button
              type="button"
              onClick={() => handlePrintOrExport(false)}
              disabled={loading}
              className="flex items-center gap-1.5 px-3.5 py-2 bg-slate-800 hover:bg-slate-700 text-slate-100 rounded-xl text-xs font-bold border border-slate-700 cursor-pointer transition-all active:scale-[0.98]"
            >
              <Printer className="w-4 h-4" />
              <span>In (A4)</span>
            </button>
            <button
              type="button"
              onClick={onClose}
              className="p-2 text-slate-400 hover:text-white hover:bg-white/10 rounded-xl transition-all cursor-pointer"
            >
              <X className="w-5 h-5" />
            </button>
          </div>
        </div>

        {/* PRINTABLE REPORT CONTENT (MULTI-PAGE A4 CANVAS) */}
        <div
          id="orientation-report-printable"
          ref={printRef}
          className="flex-1 overflow-y-auto p-6 sm:p-9 text-slate-900 font-sans leading-relaxed print:overflow-visible print:p-0 print:m-0"
        >
          {loading ? (
            <div className="py-24 text-center space-y-3">
              <RefreshCw className="w-8 h-8 animate-spin mx-auto text-[#00A19A]" />
              <p className="text-xs font-bold text-slate-500">Đang tổng hợp báo cáo nhận diện...</p>
            </div>
          ) : (
            <div className="space-y-4">

              {/* REPORT HEADER */}
              <div className="print-section border-b-2 border-slate-800 pb-3 flex items-start justify-between gap-4">
                <div className="space-y-0.5">
                  <div className="text-[11px] font-black uppercase tracking-widest text-[#00A19A]">
                    HỆ THỐNG GIÁO DỤC SKY-LINE
                  </div>
                  <div className="text-xs font-bold text-slate-800">
                    Cơ sở: {student?.admissionCampus || "Sky-Line Central"}
                  </div>
                  <div className="text-[10px] text-slate-500">
                    Hội đồng Đánh giá &amp; Tiếp nhận Học sinh Đầu vào
                  </div>
                </div>

                <div className="text-right space-y-0.5">
                  <span className="text-[10px] font-mono font-bold text-slate-600 block">
                    Mã hồ sơ: {student?.studentCode || "HS-KSDV"}
                  </span>
                  <span className="text-[10px] text-slate-500 block">
                    Ngày lập: {currentDateStr}
                  </span>
                </div>
              </div>

              {/* REPORT TITLE */}
              <div className="print-section text-center space-y-1 py-0.5">
                <h1 className="text-base sm:text-lg font-black text-slate-900 uppercase tracking-tight">
                  BÁO CÁO NHẬN DIỆN VÀ ĐỊNH HƯỚNG ĐẦU VÀO HỌC SINH
                </h1>
                <p className="text-[11px] text-slate-600 font-medium italic">
                  (Tổng hợp Hồ sơ học tập • Khảo sát môn học • Phỏng vấn học sinh • Trao đổi PHHS • Đánh giá tâm lý &amp; Chỉ đạo GĐCS)
                </p>
              </div>

              {/* SECTION I: THÔNG TIN HỌC SINH & HỒ SƠ HỌC TẬP */}
              <div className="print-section space-y-2">
                <div className="flex items-center gap-2 border-b border-slate-300 pb-1">
                  <span className="w-2 h-2 rounded-full bg-[#00A19A]" />
                  <h2 className="text-xs font-black uppercase tracking-wider text-slate-900">
                    I. Thông Tin Học Sinh &amp; Hồ Sơ Học Tập
                  </h2>
                </div>

                <div className="grid grid-cols-2 sm:grid-cols-4 gap-2.5 p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs">
                  <div>
                    <span className="text-[10px] text-slate-500 block font-medium">Họ và tên:</span>
                    <strong className="text-slate-900 text-sm font-black">{student?.fullName}</strong>
                  </div>
                  <div>
                    <span className="text-[10px] text-slate-500 block font-medium">Ngày sinh / Giới tính:</span>
                    <strong className="text-slate-800">{(() => {
                      if (!student?.dateOfBirth) return "—"
                      try {
                        const dt = new Date(student.dateOfBirth)
                        if (isNaN(dt.getTime())) return String(student.dateOfBirth)
                        const day = String(dt.getDate()).padStart(2, "0")
                        const month = String(dt.getMonth() + 1).padStart(2, "0")
                        const year = dt.getFullYear()
                        return `${day}/${month}/${year}`
                      } catch {
                        return String(student.dateOfBirth)
                      }
                    })()} ({student?.gender || "Nam"})</strong>
                  </div>
                  <div>
                    <span className="text-[10px] text-slate-500 block font-medium">Khối đăng ký:</span>
                    <strong className="text-slate-800">{student?.grade || "Khối 1"}</strong>
                  </div>
                  <div>
                    <span className="text-[10px] text-slate-500 block font-medium">Hệ đào tạo đăng ký:</span>
                    <strong className="text-slate-800">
                      {(() => {
                        const edu = orientationData?.proposedEduSystem || student?.surveyFormType;
                        if (edu && !["online", "offline"].includes(edu.trim().toLowerCase())) return edu;
                        if (student?.surveySystem && !["online", "offline"].includes(student.surveySystem.trim().toLowerCase())) return student.surveySystem;
                        return "Chất lượng cao (CLC)";
                      })()}
                    </strong>
                  </div>

                  {/* Thông tin liên lạc & trường cũ */}
                  <div className="col-span-2">
                    <span className="text-[10px] text-slate-500 block font-medium">Trường đang theo học (Trường cũ):</span>
                    <strong className="text-slate-800">{student?.oldSchoolName || "Chưa có thông tin ghi nhận"}</strong>
                  </div>
                  <div className="col-span-2">
                    <span className="text-[10px] text-slate-500 block font-medium">Thông tin liên lạc PHHS:</span>
                    <strong className="text-slate-800">
                      {student?.parentPhone || student?.phone ? `SĐT: ${student?.parentPhone || student?.phone}` : ""}
                      {student?.address ? ` • Đ/C: ${student.address}` : ""}
                      {!student?.parentPhone && !student?.phone && !student?.address && "Theo hồ sơ đăng ký tuyển sinh"}
                    </strong>
                  </div>

                  {/* Kết quả học tập & Điểm học bạ năm trước */}
                  <div className="col-span-4 pt-1 border-t border-slate-200">
                    <span className="text-[10px] text-slate-500 block font-medium">Kết quả học tập &amp; Điểm trong học bạ năm trước:</span>
                    <div className="flex flex-wrap items-center gap-2 mt-0.5">
                      <span className="text-slate-800 font-semibold">{student?.kqHocTap || student?.kqgdTieuHoc || "Hoàn thành tốt nhiệm vụ học tập"}</span>
                      {(student?.mathScore != null || student?.literatureScore != null || student?.writtenEnglishScore != null || student?.oralEnglishScore != null) && (
                        <span className="text-[11px] font-bold text-teal-900 bg-teal-50 border border-teal-200 px-2.5 py-0.5 rounded-md">
                          Điểm học bạ: {[
                            student.mathScore != null ? `Toán: ${student.mathScore}` : null,
                            student.literatureScore != null ? `Văn: ${student.literatureScore}` : null,
                            student.writtenEnglishScore != null ? `Anh viết: ${student.writtenEnglishScore}` : null,
                            student.oralEnglishScore != null ? `Anh nói: ${student.oralEnglishScore}` : null
                          ].filter(Boolean).join(" • ")}
                        </span>
                      )}
                    </div>
                  </div>
                </div>
              </div>

              {/* SECTION II: KẾT QUẢ PHỎNG VẤN HỌC SINH */}
              <div className="print-section space-y-2">
                <div className="flex items-center justify-between border-b border-slate-300 pb-1">
                  <div className="flex items-center gap-2">
                    <span className="w-2 h-2 rounded-full bg-indigo-600" />
                    <h2 className="text-xs font-black uppercase tracking-wider text-slate-900">
                      II. Nhận Diện Qua Phỏng Vấn Học Sinh
                    </h2>
                  </div>
                  <span className="text-[11px] font-bold text-indigo-700">
                    Mức độ thích nghi: {orientationData?.adaptationLevel === "CONFIDENT" ? "Sẵn sàng cao" : orientationData?.adaptationLevel === "NEED_SUPPORT" ? "Cần hỗ trợ ban đầu" : "Bình thường / Ổn định"}
                  </span>
                </div>

                {/* Danh sách tiêu chí phỏng vấn định tính */}
                {interviewList.length > 0 && (
                  <div className="border border-slate-200 rounded-xl overflow-hidden text-xs">
                    <table className="w-full text-left border-collapse">
                      <thead>
                        <tr className="bg-indigo-50/70 text-[10px] font-black uppercase text-indigo-950 border-b border-indigo-100">
                          <th className="p-2 w-10 text-center">STT</th>
                          <th className="p-2 w-1/3">Tiêu chí phỏng vấn định hướng</th>
                          <th className="p-2 w-36 text-center">Mức độ nhận diện</th>
                          <th className="p-2">Nhận xét chi tiết của Giáo viên</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-100">
                        {interviewList.map((item, idx) => {
                          const r = ratingLabel(item.rating)
                          const comment = item.teacherComment || item.notes || ""
                          return (
                            <tr key={idx} className="hover:bg-slate-50/50">
                              <td className="p-2 text-center text-slate-400 font-bold">{idx + 1}</td>
                              <td className="p-2">
                                <div className="font-bold text-slate-800 leading-snug">
                                  {item.criteriaName || item.questionText}
                                </div>
                                {item.categoryName && (
                                  <span className="text-[9px] font-bold text-indigo-600 bg-indigo-50/80 px-1.5 py-0.5 rounded mt-0.5 inline-block">
                                    {item.categoryName}
                                  </span>
                                )}
                              </td>
                              <td className="p-2 text-center">
                                <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold border inline-block ${r.cls}`}>
                                  {r.label}
                                </span>
                              </td>
                              <td className="p-2 text-slate-700 text-[11px] leading-relaxed">
                                {comment.trim() ? (
                                  <span className="font-medium text-slate-800">{comment}</span>
                                ) : (
                                  <span className="text-slate-400 italic">—</span>
                                )}
                              </td>
                            </tr>
                          )
                        })}
                      </tbody>
                    </table>
                  </div>
                )}

                {/* 3 Trường Nhận xét tổng hợp: Điểm mạnh - Cần hỗ trợ - Đề xuất định hướng tiếp nhận */}
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
                  <div className="p-2.5 bg-emerald-50/70 rounded-xl border border-emerald-200">
                    <span className="text-[10px] font-black text-emerald-800 uppercase block mb-1">
                      1. Điểm mạnh &amp; Tiềm năng:
                    </span>
                    <p className="text-slate-800 text-[11px] leading-relaxed font-medium">
                      {orientationData?.studentStrengths?.trim() || (
                        <span className="text-slate-400 italic">Chưa ghi nhận</span>
                      )}
                    </p>
                  </div>

                  <div className="p-2.5 bg-amber-50/70 rounded-xl border border-amber-200">
                    <span className="text-[10px] font-black text-amber-800 uppercase block mb-1">
                      2. Nội dung cần hỗ trợ phát hiện sớm:
                    </span>
                    <p className="text-slate-800 text-[11px] leading-relaxed font-medium">
                      {orientationData?.studentNeedsSupport?.trim() || (
                        <span className="text-slate-400 italic">Chưa ghi nhận</span>
                      )}
                    </p>
                  </div>

                  <div className="p-2.5 bg-indigo-50/70 rounded-xl border border-indigo-200">
                    <span className="text-[10px] font-black text-indigo-800 uppercase block mb-1">
                      3. Đề xuất định hướng tiếp nhận:
                    </span>
                    <p className="text-slate-800 text-[11px] leading-relaxed font-medium">
                      {proposedPlacementRecommendation?.trim() || orientationData?.interviewerGeneralRemark?.trim() || (
                        <span className="text-slate-400 italic">Chưa ghi nhận</span>
                      )}
                    </p>
                  </div>
                </div>

                {/* Khu vực thông tin thẩm định QLCM Cơ sở & Liên thông */}
                {(verificationInfo || orientationData?.interviewerName) && (
                  <div className="p-2.5 bg-slate-50/90 rounded-xl border border-slate-200 text-xs space-y-1.5">
                    <div className="flex flex-wrap items-center justify-between gap-2 text-[11px]">
                      <div className="flex items-center gap-2">
                        <span className="font-black text-slate-700 uppercase">Cán bộ / GV phỏng vấn:</span>
                        <span className="font-bold text-slate-900">{orientationData?.interviewerName || "GV Phỏng vấn"}</span>
                      </div>
                      {verificationInfo && (
                        <div className="flex items-center gap-2">
                          <span className="font-black text-slate-700 uppercase">Thẩm định QLCM:</span>
                          <span className={`px-2 py-0.5 rounded-full font-bold text-[10px] border ${
                            verificationInfo.status === "VERIFIED"
                              ? "bg-emerald-100 text-emerald-800 border-emerald-300"
                              : verificationInfo.status === "REJECTED"
                              ? "bg-rose-100 text-rose-800 border-rose-300"
                              : "bg-amber-100 text-amber-800 border-amber-300"
                          }`}>
                            {verificationInfo.status === "VERIFIED" ? "✓ Đã thẩm định" : verificationInfo.status === "REJECTED" ? "✕ Cần bổ sung" : "⏳ Chờ thẩm định"}
                          </span>
                          {verificationInfo.verifierName && (
                            <span className="text-slate-600 font-semibold">({verificationInfo.verifierName})</span>
                          )}
                        </div>
                      )}
                    </div>

                    {verificationInfo?.notes && (
                      <p className="text-[11px] text-slate-600 italic">
                        Ý kiến QLCM: {verificationInfo.notes}
                      </p>
                    )}

                    {verificationInfo?.supportReferralConfirmed && (
                      <div className="text-[10.5px] font-bold text-teal-800 flex items-center gap-1.5 pt-0.5 border-t border-slate-200/60">
                        <span>✓</span>
                        <span>Đã xác nhận liên thông nhu cầu hỗ trợ sang Hồ sơ học tập sau nhập học</span>
                      </div>
                    )}
                  </div>
                )}
              </div>

              {/* SECTION III: TRAO ĐỔI VỚI PHHS */}
              <div className="print-section space-y-2">
                <div className="flex items-center justify-between border-b border-slate-300 pb-1">
                  <div className="flex items-center gap-2">
                    <span className="w-2 h-2 rounded-full bg-purple-600" />
                    <h2 className="text-xs font-black uppercase tracking-wider text-slate-900">
                      III. Trao Đổi &amp; Phối Hợp Giáo Dục Với Phụ Huynh Học Sinh (PHHS)
                    </h2>
                  </div>
                  <span className="text-[11px] font-bold text-purple-700">
                    {orientationData?.parentRepresentativeName ? `Đại diện: ${orientationData.parentRepresentativeName}` : "Đại diện gia đình trao đổi"} {orientationData?.parentPhone ? `• SĐT: ${orientationData.parentPhone}` : ""}
                  </span>
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
                  <div className="p-2.5 bg-purple-50/60 rounded-xl border border-purple-200 flex flex-col">
                    <span className="text-[10px] font-black text-purple-900 uppercase block mb-0.5">
                      1. Nguyện vọng &amp; Kỳ vọng của PHHS:
                    </span>
                    <p className="text-slate-800 text-[11px] leading-relaxed">
                      {orientationData?.parentExpectations?.trim() || (
                        <span className="text-slate-400 italic">Chưa có thông tin ghi nhận</span>
                      )}
                    </p>
                  </div>

                  <div className="p-2.5 bg-purple-50/60 rounded-xl border border-purple-200 flex flex-col">
                    <span className="text-[10px] font-black text-purple-900 uppercase block mb-0.5">
                      2. Đặc điểm cá nhân, sở thích &amp; thói quen:
                    </span>
                    <p className="text-slate-800 text-[11px] leading-relaxed">
                      {orientationData?.parentPersonalityNotes?.trim() || (
                        <span className="text-slate-400 italic">Chưa có thông tin ghi nhận</span>
                      )}
                    </p>
                  </div>

                  <div className="p-2.5 bg-purple-50/60 rounded-xl border border-purple-200 flex flex-col">
                    <span className="text-[10px] font-black text-purple-900 uppercase block mb-0.5">
                      3. Nhu cầu hỗ trợ &amp; Đề xuất từ PHHS:
                    </span>
                    <p className="text-slate-800 text-[11px] leading-relaxed">
                      {orientationData?.parentSpecialRequests?.trim() || (
                        <span className="text-slate-400 italic">Chưa có thông tin ghi nhận</span>
                      )}
                    </p>
                  </div>

                  <div className="p-2.5 bg-purple-50/60 rounded-xl border border-purple-200 flex flex-col">
                    <span className="text-[10px] font-black text-purple-900 uppercase block mb-0.5">
                      4. Nội dung phối hợp giữa Gia đình &amp; Nhà trường:
                    </span>
                    <p className="text-slate-800 text-[11px] leading-relaxed font-medium">
                      {orientationData?.cooperationCommitment?.trim() || (
                        <span className="text-slate-400 italic">Chưa có thông tin ghi nhận</span>
                      )}
                    </p>
                  </div>
                </div>
              </div>

              {/* VẠCH CHUYỂN TRANG LOGIC TRONG BẢN IN NẾU CẦN */}
              <div className="print-page-break hidden print:block" />

              {/* IV. KẾT QUẢ ĐÁNH GIÁ TÂM LÝ CHI TIẾT (BÁO CÁO GIÁO VIÊN TÂM LÝ -> GĐCS) */}
              {(psychologyInfo.hasIssue || psychologyInfo.pData) && (
                <div className="print-section p-3 bg-amber-50/70 rounded-xl border border-amber-300 text-xs space-y-2.5">
                  <div className="flex flex-wrap items-center justify-between gap-2 border-b border-amber-200 pb-1.5">
                    <div className="flex items-center gap-2">
                      <span className="w-5 h-5 rounded-md bg-amber-700 text-white flex items-center justify-center font-black text-[11px]">
                        IV
                      </span>
                      <div>
                        <h3 className="text-xs font-black uppercase text-amber-950 tracking-wider">
                          IV. Kết Quả Đánh Giá Tâm Lý Chi Tiết (Báo Cáo Giáo Viên Tâm Lý &rarr; GĐCS)
                        </h3>
                        <p className="text-[10px] text-amber-800 font-medium">
                          Kết quả thang đo sàng lọc tâm lý, kết luận chuyên môn và đề xuất gửi Ban Giám đốc Cơ sở
                        </p>
                      </div>
                    </div>
                    {psychologyInfo.pData?.evaluation?.level && (
                      <span className="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-300 font-black text-[10px]">
                        {psychologyInfo.pData.evaluation.level}
                      </span>
                    )}
                  </div>

                  {/* Thông tin Email đã gửi cho GĐCS */}
                  {psychologyInfo.pData?.reportedToGdcs && (
                    <div className="p-2.5 bg-white/95 rounded-lg border border-amber-300/80 text-[11px] space-y-1">
                      <div className="flex items-center justify-between text-amber-950 font-bold border-b border-amber-100 pb-1">
                        <span className="flex items-center gap-1.5 text-[10px] uppercase tracking-wide">
                          <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600" />
                          Đã Gửi Email Báo Cáo Đến Giám Đốc Cơ Sở
                        </span>
                        <span className="text-[10px] text-slate-500 font-normal">
                          {psychologyInfo.pData.reportedToGdcs.reportedAt
                            ? new Date(psychologyInfo.pData.reportedToGdcs.reportedAt).toLocaleString("vi-VN")
                            : "Đã gửi"}
                        </span>
                      </div>
                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-0.5 text-slate-700">
                        <div>
                          <span className="text-slate-500 text-[10px] block">GĐCS Tiếp Nhận:</span>
                          <strong className="text-slate-900">{psychologyInfo.pData.reportedToGdcs.gdcsName}</strong>
                          <span className="text-slate-500 text-[10px] block">({psychologyInfo.pData.reportedToGdcs.gdcsEmail})</span>
                        </div>
                        <div>
                          <span className="text-slate-500 text-[10px] block">Người Gửi (GV Tâm lý):</span>
                          <strong className="text-slate-900">{psychologyInfo.pData.reportedToGdcs.reportedBy || psychologyInfo.teacherName || "Giáo viên Tâm lý"}</strong>
                        </div>
                      </div>
                      {psychologyInfo.pData.reportedToGdcs.messageToGdcs && (
                        <div className="pt-1 text-slate-800 text-[11px] bg-amber-50/60 p-2 rounded border border-amber-200 italic">
                          <span className="font-semibold not-italic text-slate-600">Nội dung đề xuất gửi GĐCS: </span>
                          &quot;{psychologyInfo.pData.reportedToGdcs.messageToGdcs}&quot;
                        </div>
                      )}
                    </div>
                  )}

                  {/* Điểm số các phần và tổng kết 6 thang đo */}
                  <div className="grid grid-cols-3 sm:grid-cols-6 gap-1.5">
                    {[
                      { label: "1. Cảm xúc & điều hòa", score: psychologyInfo.pData?.sectionScores?.[0] },
                      { label: "2. Hành vi & tự kiểm soát", score: psychologyInfo.pData?.sectionScores?.[1] },
                      { label: "3. Giao tiếp xã hội", score: psychologyInfo.pData?.sectionScores?.[2] },
                      { label: "4. Chú ý & kỹ năng học", score: psychologyInfo.pData?.sectionScores?.[3] },
                      { label: "5. Vận động & giác quan", score: psychologyInfo.pData?.sectionScores?.[4] },
                      { label: "6. Thích ứng & tự lập", score: psychologyInfo.pData?.sectionScores?.[5] }
                    ].map((sec, idx) => (
                      <div key={idx} className="p-1.5 bg-white/90 rounded-lg border border-amber-200 text-center">
                        <span className="text-[9px] text-slate-600 block leading-tight font-medium h-5 flex items-center justify-center">
                          {sec.label}
                        </span>
                        <strong className="text-amber-950 font-black text-xs block mt-0.5">
                          {sec.score !== undefined && sec.score !== null ? `${sec.score} đ` : "-"}
                        </strong>
                      </div>
                    ))}
                  </div>

                  {/* Kết luận & Khuyến nghị chuyên môn */}
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-0.5 text-[11px]">
                    <div className="p-2 bg-white/95 rounded-lg border border-amber-200 space-y-1">
                      <span className="font-bold text-amber-950 uppercase text-[10px] block">
                        Kết Luận Chuyên Môn GV Tâm Lý:
                      </span>
                      <p className="text-slate-800 leading-relaxed font-medium">
                        {psychologyInfo.pData?.conclusion || psychologyInfo.reason || "Học sinh có dấu hiệu cần quan sát và hỗ trợ hòa nhập bước đầu."}
                      </p>
                    </div>
                    <div className="p-2 bg-white/95 rounded-lg border border-amber-200 space-y-1">
                      <span className="font-bold text-amber-950 uppercase text-[10px] block">
                        Khuyến Nghị &amp; Đề Xuất Biện Pháp:
                      </span>
                      <p className="text-slate-800 leading-relaxed font-medium">
                        {psychologyInfo.pData?.recommendation || psychologyInfo.pData?.evaluation?.suggestion || "Cần có phương án đồng hành và trao đổi thống nhất định hướng với gia đình."}
                      </p>
                    </div>
                  </div>
                </div>
              )}

              {/* V. PHƯƠNG ÁN XỬ LÝ & CHỈ ĐẠO CỦA GIÁM ĐỐC CƠ SỞ (GĐCS) */}
              <div className="print-section p-3 bg-gradient-to-r from-indigo-50/80 via-purple-50/70 to-pink-50/70 rounded-xl border border-indigo-200 text-xs space-y-2.5">
                <div className="flex flex-wrap items-center justify-between gap-2 border-b border-indigo-200/80 pb-1.5">
                  <div className="flex items-center gap-2">
                    <span className="w-5 h-5 rounded-md bg-indigo-700 text-white flex items-center justify-center font-black text-[11px]">
                      V
                    </span>
                    <div>
                      <h3 className="text-xs font-black uppercase text-indigo-950 tracking-wider">
                        V. Phương Án Xử Lý &amp; Chỉ Đạo Của Giám Đốc Cơ Sở (GĐCS)
                      </h3>
                      <p className="text-[10px] text-indigo-800 font-medium">
                        Ủy quyền GV hỗ trợ, gặp trực tiếp PHHS hoặc thiết lập lịch làm việc hội chẩn chuyên sâu
                      </p>
                    </div>
                  </div>
                </div>

                {/* 3 HÌNH THỨC CHỈ ĐẠO CỦA GĐCS */}
                <div className="space-y-1.5 pt-0.5">
                  {/* 1. Ủy quyền GV */}
                  {gdcsData?.delegateTeacher && (
                    <div className="p-2.5 bg-white rounded-lg border border-indigo-200 text-[11px] space-y-1">
                      <div className="flex items-center justify-between text-indigo-950 font-bold">
                        <span className="flex items-center gap-1.5">
                          <UserCheck className="w-3.5 h-3.5 text-indigo-600" />
                          1. Ủy Quyền Giáo Viên Đồng Hành &amp; Hỗ Trợ:
                        </span>
                        <span className="px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-200 text-[10px]">
                          GV Được Ủy Quyền
                        </span>
                      </div>
                      <div className="text-slate-700 pl-5">
                        <div>Giáo viên phụ trách: <strong className="text-slate-900">{gdcsData.delegatedTeacherName || "Chưa chọn GV"}</strong></div>
                        {gdcsData.delegationNote && (
                          <div className="text-slate-600 italic mt-0.5">Nội dung chỉ đạo: &quot;{gdcsData.delegationNote}&quot;</div>
                        )}
                      </div>
                    </div>
                  )}

                  {/* 2. Trao đổi trực tiếp PHHS */}
                  {gdcsData?.directParentMeeting && (
                    <div className="p-2.5 bg-white rounded-lg border border-purple-200 text-[11px] space-y-1">
                      <div className="flex items-center justify-between text-purple-950 font-bold">
                        <span className="flex items-center gap-1.5">
                          <Users className="w-3.5 h-3.5 text-purple-600" />
                          2. Trao Đổi Trực Tiếp Với Phụ Huynh Học Sinh (PHHS):
                        </span>
                        <span className="px-2 py-0.5 rounded-md bg-purple-50 text-purple-800 border border-purple-200 text-[10px]">
                          Hẹn Gặp PHHS
                        </span>
                      </div>
                      <div className="text-slate-700 pl-5 space-y-0.5">
                        <div>Thời gian hẹn gặp: <strong className="text-slate-900">{gdcsData.parentMeetingTime || "Tư vấn liên hệ thống nhất"}</strong> {gdcsData.parentMeetingLocation ? `• Tại: ${gdcsData.parentMeetingLocation}` : ""}</div>
                        {gdcsData.parentMeetingContent && <div className="text-slate-600 italic">Nội dung trao đổi: &quot;{gdcsData.parentMeetingContent}&quot;</div>}
                      </div>
                    </div>
                  )}

                  {/* 3. Đặt lịch làm việc */}
                  {gdcsData?.scheduleMeeting && (
                    <div className="p-2.5 bg-white rounded-lg border border-teal-200 text-[11px] space-y-1">
                      <div className="flex items-center justify-between text-teal-950 font-bold">
                        <span className="flex items-center gap-1.5">
                          <Calendar className="w-3.5 h-3.5 text-teal-600" />
                          3. Đặt Lịch Làm Việc Chuyên Sâu / Hội Chẩn:
                        </span>
                        <span className="px-2 py-0.5 rounded-md bg-teal-50 text-teal-800 border border-teal-200 text-[10px]">
                          Lịch Hẹn GĐCS
                        </span>
                      </div>
                      <div className="text-slate-700 pl-5 space-y-0.5">
                        <div>Thời gian: <strong className="text-slate-900">{gdcsData.meetingTime || "Theo thông báo của GĐCS"}</strong> {gdcsData.meetingLocation ? `• Tại: ${gdcsData.meetingLocation}` : ""}</div>
                        {gdcsData.meetingParticipants && <div>Thành phần: <span className="font-semibold text-slate-800">{gdcsData.meetingParticipants}</span></div>}
                        {gdcsData.meetingAgenda && <div className="text-slate-600 italic">Nội dung: &quot;{gdcsData.meetingAgenda}&quot;</div>}
                      </div>
                    </div>
                  )}

                  {!gdcsData?.delegateTeacher && !gdcsData?.directParentMeeting && !gdcsData?.scheduleMeeting && (
                    <div className="p-2 bg-white/80 rounded-lg border border-slate-200 text-[11px] text-slate-500 italic text-center">
                      Không có chỉ định hỗ trợ đặc biệt (Học sinh tiếp nhận theo lộ trình chuẩn thông thường)
                    </div>
                  )}
                </div>
              </div>

              {/* VI. KẾT QUẢ KHẢO SÁT CÁC MÔN HỌC (TẠI SKY-LINE, NẾU CÓ) */}
              <div className="print-section p-3 bg-blue-50/60 rounded-xl border border-blue-200 text-xs space-y-2.5">
                <div className="flex flex-wrap items-center justify-between gap-2 border-b border-blue-200 pb-1.5">
                  <div className="flex items-center gap-2">
                    <span className="w-5 h-5 rounded-md bg-blue-700 text-white flex items-center justify-center font-black text-[11px]">
                      VI
                    </span>
                    <div>
                      <h3 className="text-xs font-black uppercase text-blue-950 tracking-wider">
                        VI. Kết Quả Khảo Sát Các Môn Học (Tại Sky-Line, Nếu Có)
                      </h3>
                      <p className="text-[10px] text-blue-800 font-medium">
                        Điểm bài khảo sát năng lực đầu vào các môn học thuật do giáo viên chuyên môn chấm
                      </p>
                    </div>
                  </div>
                  <span className="px-2 py-0.5 rounded-full bg-blue-100 text-blue-900 font-bold text-[10px]">
                    {subjectScores.length} môn khảo sát
                  </span>
                </div>

                {subjectScores.length > 0 ? (
                  <div className="overflow-x-auto rounded-lg border border-blue-200 bg-white">
                    <table className="w-full text-[11px] text-left">
                      <thead className="bg-blue-100/70 text-blue-950 font-bold border-b border-blue-200">
                        <tr>
                          <th className="py-1 px-3 w-10 text-center">STT</th>
                          <th className="py-1 px-3">Môn Khảo Sát</th>
                          <th className="py-1 px-3 w-28 text-center">Điểm Đạt Được</th>
                          <th className="py-1 px-3">Nhận Xét Của Giáo Viên Chuyên Môn</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-blue-100 text-slate-800">
                        {subjectScores.map((item, idx) => (
                          <tr key={idx} className="hover:bg-blue-50/40">
                            <td className="py-1 px-3 text-center font-bold text-slate-500">{idx + 1}</td>
                            <td className="py-1 px-3 font-bold text-blue-950">{item.subject}</td>
                            <td className="py-1 px-3 text-center">
                              <span className="px-2 py-0.5 rounded-full font-black text-xs bg-blue-50 text-blue-900 border border-blue-200">
                                {item.score}
                              </span>
                            </td>
                            <td className="py-1 px-3 text-slate-700 italic">
                              {item.remark || <span className="text-slate-400 not-italic">Đạt yêu cầu bài khảo sát</span>}
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ) : (
                  <div className="p-2 bg-white/90 rounded-lg border border-blue-100 text-center text-slate-500 italic text-[11px]">
                    Chưa ghi nhận bài khảo sát môn học hoặc học sinh thuộc diện miễn khảo sát học thuật.
                  </div>
                )}
              </div>

              {/* VII. PHÊ DUYỆT & XÉT DUYỆT TIẾP NHẬN CỦA GIÁM ĐỐC CƠ SỞ (GĐCS) */}
              <div className="print-section p-3 bg-gradient-to-r from-teal-50/80 via-emerald-50/70 to-teal-50/80 rounded-xl border border-teal-300 text-xs space-y-2.5">
                <div className="flex flex-wrap items-center justify-between gap-2 border-b border-teal-200/80 pb-1.5">
                  <div className="flex items-center gap-2">
                    <span className="w-5 h-5 rounded-md bg-teal-800 text-white flex items-center justify-center font-black text-[11px]">
                      VII
                    </span>
                    <div>
                      <h3 className="text-xs font-black uppercase text-teal-950 tracking-wider">
                        VII. Phê Duyệt &amp; Xét Duyệt Tiếp Nhận Của Giám Đốc Cơ Sở (GĐCS)
                      </h3>
                      <p className="text-[10px] text-teal-800 font-medium">
                        Quyết định tiếp nhận, hệ đào tạo, phân lớp và phân luồng thông tin chỉ đạo
                      </p>
                    </div>
                  </div>
                  <span className={`px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase border ${
                    gdcsData?.gdcsDecision === "TIEP_NHAN_DONG_HANH"
                      ? "bg-amber-100 text-amber-900 border-amber-300"
                      : gdcsData?.gdcsDecision === "TAM_HOAN_DANH_GIA"
                      ? "bg-rose-100 text-rose-900 border-rose-300"
                      : "bg-emerald-100 text-emerald-900 border-emerald-300"
                  }`}>
                    {gdcsData?.gdcsDecision === "TIEP_NHAN_DONG_HANH"
                      ? "Tiếp nhận kèm Kế hoạch đồng hành đặc biệt"
                      : gdcsData?.gdcsDecision === "TAM_HOAN_DANH_GIA"
                      ? "Tạm hoãn • Cần hội chẩn đánh giá thêm"
                      : "Sẵn sàng tiếp nhận • Theo chuẩn đào tạo"}
                  </span>
                </div>

                {/* Hệ đào tạo */}
                <div className="pt-0.5">
                  <div className="p-2 bg-white/95 rounded-lg border border-teal-200 flex items-center justify-between">
                    <span className="text-[10px] text-slate-500 font-medium">Hệ đào tạo phê duyệt:</span>
                    <strong className="text-teal-950 font-black text-xs">
                      {(() => {
                        const edu = orientationData?.proposedEduSystem || student?.surveyFormType;
                        if (edu && !["online", "offline"].includes(edu.trim().toLowerCase())) return edu;
                        if (student?.surveySystem && !["online", "offline"].includes(student.surveySystem.trim().toLowerCase())) return student.surveySystem;
                        return "Chất lượng cao (CLC)";
                      })()}
                    </strong>
                  </div>
                </div>

                {/* Ý kiến chỉ đạo khác */}
                {gdcsData?.gdcsGeneralNote && (
                  <div className="p-2 bg-white/95 rounded-lg border border-teal-200 text-[11px] text-slate-800">
                    <strong className="text-teal-950">Ý kiến chỉ đạo chung của GĐCS: </strong> 
                    {gdcsData.gdcsGeneralNote}
                  </div>
                )}

                {/* THÔNG TIN PHÂN LUỒNG NHẬN KẾT QUẢ TỪ GĐCS */}
                <div className="pt-1.5 border-t border-teal-200/80 flex flex-wrap items-center justify-between gap-2 text-[10px] text-teal-900 font-semibold">
                  <span className="flex items-center gap-1">
                    <CheckCircle2 className="w-3.5 h-3.5 text-emerald-600" />
                    <strong>Tư vấn Tuyển sinh:</strong> Nhận kết quả để làm thủ tục nhập học &amp; thỏa thuận PHHS
                  </span>
                  <span className="flex items-center gap-1">
                    <CheckCircle2 className="w-3.5 h-3.5 text-indigo-600" />
                    <strong>GV Đồng hành:</strong> Nhận chỉ đạo theo dõi
                  </span>
                  <span className="flex items-center gap-1">
                    <CheckCircle2 className="w-3.5 h-3.5 text-purple-600" />
                    <strong>Lịch làm việc:</strong> Đã ghi nhận lịch hẹn
                  </span>
                </div>
              </div>

              {/* VIII. LỊCH SỬ TIẾN TRÌNH & THEO DÕI NGHIỆP VỤ (AUDIT TRAIL 5 MỐC) */}
              <div className="print-section p-3 bg-slate-50 rounded-xl border border-slate-300 text-xs space-y-2">
                <div className="flex items-center justify-between border-b border-slate-200 pb-1">
                  <div className="flex items-center gap-2">
                    <span className="w-5 h-5 rounded-md bg-slate-700 text-white flex items-center justify-center font-black text-[11px]">
                      VIII
                    </span>
                    <h3 className="text-xs font-black uppercase text-slate-900 tracking-wider">
                      VIII. Lịch Sử Tiến Trình &amp; Theo Dõi Nghiệp Vụ (Hệ Thống Tự Động Lưu Vết)
                    </h3>
                  </div>
                  <span className="text-[10px] text-slate-500 font-semibold italic">
                    Quy trình: GV định hướng &rarr; GV tâm lý &rarr; GĐCS chỉ đạo &rarr; Điểm môn học &rarr; Xét duyệt
                  </span>
                </div>

                <div className="grid grid-cols-5 gap-1.5 text-[10.5px]">
                  {/* MỐC 1 */}
                  <div className="p-1.5 bg-white rounded-lg border border-teal-200 space-y-0.5">
                    <span className="font-bold text-teal-800 uppercase block text-[9.5px]">1. GV Định Hướng</span>
                    <strong className="text-slate-900 block truncate">{orientationData?.interviewerName || "Cán bộ định hướng"}</strong>
                    <span className="text-slate-500 text-[9px] block">
                      {orientationData?.interviewDate ? new Date(orientationData.interviewDate).toLocaleDateString("vi-VN") : "Đã phỏng vấn"}
                    </span>
                    <div className="text-teal-900 text-[9px] bg-teal-50 p-0.5 rounded">Phỏng vấn HS &amp; PHHS</div>
                  </div>

                  {/* MỐC 2 */}
                  <div className="p-1.5 bg-white rounded-lg border border-amber-200 space-y-0.5">
                    <span className="font-bold text-amber-800 uppercase block text-[9.5px]">2. GV Tâm Lý</span>
                    <strong className="text-slate-900 block truncate">
                      {psychologyInfo.pData?.reportedToGdcs?.reporterName || psychologyInfo.teacherName || (psychologyInfo.hasIssue ? "GV Tâm lý" : "Theo dõi chung")}
                    </strong>
                    <span className="text-slate-500 text-[9px] block">
                      {psychologyInfo.pData?.reportedToGdcs?.reportedAt
                        ? new Date(psychologyInfo.pData.reportedToGdcs.reportedAt).toLocaleDateString("vi-VN")
                        : (psychologyInfo.hasIssue ? "Đã gửi báo cáo" : "Không yêu cầu")}
                    </span>
                    <div className="text-amber-950 text-[9px] bg-amber-50 p-0.5 rounded truncate">
                      {psychologyInfo.pData ? `Điểm: ${psychologyInfo.pData.totalScore}đ (${psychologyInfo.pData.evaluation?.level || 'Lưu ý'})` : "Tâm lý bình thường"}
                    </div>
                  </div>

                  {/* MỐC 3 */}
                  <div className="p-1.5 bg-white rounded-lg border border-indigo-200 space-y-0.5">
                    <span className="font-bold text-indigo-900 uppercase block text-[9.5px]">3. GĐCS Chỉ Đạo</span>
                    <strong className="text-indigo-950 block truncate">
                      {gdcsData?.delegateTeacher
                        ? `Ủy quyền: ${gdcsData.delegatedTeacherName || "GV phụ trách"}`
                        : gdcsData?.directParentMeeting
                        ? "Gặp trực tiếp PHHS"
                        : gdcsData?.scheduleMeeting
                        ? "Hẹn lịch hội chẩn"
                        : "Tiếp nhận chuẩn"}
                    </strong>
                    <span className="text-slate-500 text-[9px] block">
                      {gdcsData?.parentMeetingTime || gdcsData?.meetingTime || "Chỉ đạo đồng hành"}
                    </span>
                    <div className="text-indigo-950 text-[9px] bg-indigo-50 p-0.5 rounded truncate">
                      {gdcsData?.delegateTeacher ? "Đã phân công GV" : gdcsData?.directParentMeeting ? "Lịch gặp PHHS" : gdcsData?.scheduleMeeting ? "Lịch hội chẩn" : "Quy trình chuẩn"}
                    </div>
                  </div>

                  {/* MỐC 4 */}
                  <div className="p-1.5 bg-white rounded-lg border border-blue-200 space-y-0.5">
                    <span className="font-bold text-blue-900 uppercase block text-[9.5px]">4. Các Môn Khảo Sát</span>
                    <strong className="text-slate-900 block truncate">
                      {subjectScores.length > 0 ? `${subjectScores.length} môn học thuật` : "Miễn bài thi"}
                    </strong>
                    <span className="text-slate-500 text-[9px] block">
                      {subjectScores.length > 0 ? "Theo GV chấm điểm" : "Hồ sơ xét tuyển"}
                    </span>
                    <div className="text-blue-950 text-[9px] bg-blue-50 p-0.5 rounded truncate">
                      {subjectScores.length > 0 ? subjectScores.map(s => `${s.subject}: ${s.score}`).join(" • ") : "Đã ghi nhận học bạ"}
                    </div>
                  </div>

                  {/* MỐC 5 */}
                  <div className="p-1.5 bg-white rounded-lg border border-teal-200 space-y-0.5">
                    <span className="font-bold text-teal-900 uppercase block text-[9.5px]">5. Xét Duyệt GĐCS</span>
                    <strong className="text-slate-900 block truncate">
                      {gdcsData?.gdcsDecision === "TIEP_NHAN_CHUAN"
                        ? "Sẵn sàng tiếp nhận"
                        : gdcsData?.gdcsDecision === "TIEP_NHAN_DONG_HANH"
                        ? "Kế hoạch đồng hành"
                        : "Cần hội chẩn thêm"}
                    </strong>
                    <span className="text-slate-500 text-[9px] block truncate">
                      Hệ: {orientationData?.proposedEduSystem || student?.surveyFormType || "CLC"}
                    </span>
                    <div className="text-teal-950 text-[9px] bg-teal-50 p-0.5 rounded truncate">
                      Phê duyệt tiếp nhận
                    </div>
                  </div>
                </div>
              </div>

              {/* REPORT SIGNATURE AREA */}
              <div className="print-section pt-6 grid grid-cols-2 text-center text-xs">
                <div className="space-y-14">
                  <div>
                    <span className="font-bold text-slate-800 block uppercase text-[11px]">Giáo viên Tiếp nhận &amp; Phỏng vấn</span>
                    <span className="text-[10px] text-slate-500 italic">(Ký và ghi rõ họ tên)</span>
                  </div>
                  <div className="font-black text-slate-900">
                    {orientationData?.interviewerName || "Cán bộ tiếp nhận"}
                  </div>
                </div>

                <div className="space-y-14">
                  <div>
                    <span className="font-bold text-slate-800 block uppercase text-[11px]">Giám Đốc Cơ Sở (GĐCS)</span>
                    <span className="text-[10px] text-slate-500 italic">(Ký và phê duyệt tiếp nhận)</span>
                  </div>
                  <div className="font-black text-slate-900">
                    {student?.admissionCampus ? `Giám đốc Cơ sở ${student.admissionCampus}` : "Giám đốc Cơ sở Sky-Line"}
                  </div>
                </div>
              </div>

              {/* FOOTER NOTE */}
              <div className="print-section pt-3 border-t border-slate-200 text-center text-[10px] text-slate-400 italic">
                * Báo cáo này là tài liệu nhận diện định hướng giáo dục nội bộ thuộc Hệ thống Giáo dục Sky-Line, không có giá trị xếp loại thi đua hay áp lực điểm số đối với học sinh.
              </div>

            </div>
          )}
        </div>

      </div>

      {/* NATIVE PRINT STYLES AS FALLBACK FOR DIRECT CTRL+P */}
      <style dangerouslySetInnerHTML={{ __html: `
        @media print {
          @page {
            size: A4 portrait;
            margin: 8mm 10mm 10mm 10mm;
          }
          html, body {
            width: 100% !important;
            height: auto !important;
            min-height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            background: #ffffff !important;
            color: #0f172a !important;
            overflow: visible !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
          }
          /* Khi có direct-print-root (được gắn trực tiếp vào body), chỉ in duy nhất vùng này */
          body > #direct-print-root {
            display: block !important;
            position: static !important;
            width: 100% !important;
            max-width: 195mm !important;
            margin: 0 auto !important;
            padding: 0 !important;
            background: #ffffff !important;
            color: #0f172a !important;
            overflow: visible !important;
          }
          body > #direct-print-root * {
            visibility: visible !important;
          }
          /* Nếu in bằng direct-print-root thì ẩn tất cả các thẻ con khác của body */
          body:has(#direct-print-root) > *:not(#direct-print-root) {
            display: none !important;
          }

          /* Fallback cho trường hợp in Ctrl+P trực tiếp từ modal */
          .no-print-backdrop {
            display: block !important;
            position: static !important;
            inset: auto !important;
            width: 100% !important;
            height: auto !important;
            min-height: 0 !important;
            background: transparent !important;
            backdrop-filter: none !important;
            padding: 0 !important;
            margin: 0 !important;
            overflow: visible !important;
          }
          #orientation-report-main-container {
            display: block !important;
            position: static !important;
            width: 100% !important;
            max-width: 195mm !important;
            height: auto !important;
            min-height: 0 !important;
            margin: 0 auto !important;
            padding: 0 !important;
            border: none !important;
            box-shadow: none !important;
            background: #ffffff !important;
            overflow: visible !important;
          }
          #orientation-report-printable {
            display: block !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: visible !important;
          }
          .print-section {
            break-inside: avoid !important;
            page-break-inside: avoid !important;
          }
          .print-page-break {
            break-before: page !important;
            page-break-before: always !important;
          }
          .no-print {
            display: none !important;
          }
        }
      ` }} />
    </div>
  )
}
