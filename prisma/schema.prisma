  roomOverride        String?
  onlineLinkOverride  String?
  preparationNotes    String?
  keyDocumentsJson    String?
  totalStudents       Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  meeting             ParentMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, classId])
  @@index([classId])
  @@index([homeroomTeacherId])
  @@map("parent_meeting_classes")
}

model ParentMeetingInvitation {
  id                   String        @id @default(cuid())
  meetingId            String
