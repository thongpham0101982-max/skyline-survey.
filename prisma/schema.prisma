// ============================================================================
// MODULE: QUẢN LÝ KẾT QUẢ CÁC KỲ THI QUỐC TẾ & CHỨNG CHỈ HỌC SINH
// ============================================================================

model IntlExamRuleSet {
  id                  String   @id @default(cuid())
  examFamily          String   // CAMBRIDGE_YLE | CAMBRIDGE_MAIN | IELTS | PEARSON_EDEXCEL | CAMBRIDGE_CHECKPOINT
  examType            String   // STARTERS | MOVERS | FLYERS | KET | PET | IELTS | IPRIMARY | ILOWERSECONDARY | PRIMARY_CHECKPOINT | LOWER_SECONDARY_CHECKPOINT
  versionCode         String   @unique // e.g., "KET_CAMBRIDGE_SCALE_2020_V1", "CHECKPOINT_50_2023_V1"
  versionName         String
  organization        String   // "Cambridge English", "Cambridge International", "IELTS Partners", "Pearson Edexcel"
  effectiveFrom       DateTime @default(now())
  effectiveTo         DateTime?
  scaleUnit           String   // "SHIELD" | "CAMBRIDGE_SCALE" | "IELTS_BAND" | "PEARSON_SCORE" | "CHECKPOINT_50" | "CHECKPOINT_6"
  minOverall          Float?
  maxOverall          Float?
  stepSize            Float?   @default(1.0)
  gradeBoundariesJson String   // JSON array of official grade/CEFR/level rules
  skylineTargetsJson  String?  // JSON object of configurable Sky-Line internal targets (e.g., 10 shields, IELTS 6.5)
  skillsConfigJson    String   // JSON array of official skills/subjects & min/max per component
  allowPartialImport  Boolean  @default(true)
  isDefault           Boolean  @default(true)
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sessions            IntlExamSession[]
  results             IntlExamResult[]

  @@index([examFamily, examType, isDefault])
}

model IntlExamSession {
  id               String   @id @default(cuid())
  sessionCode      String   @unique // e.g., "CAM-FLYERS-2026-08", "CHK-SEC-2024-2025"
  sessionName      String   // e.g., "Kỳ thi Cambridge Tháng 08/2026", "Cambridge Checkpoint 2024-2025"
  examFamily       String
  examType         String
  academicYearId   String?
  academicYearText String   // e.g., "2024-2025", "2025-2026", "2026-2027"
  examDate         DateTime?
  examMonth        Int?
  examYear         Int?
  ruleSetId        String
  notes            String?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ruleSet          IntlExamRuleSet  @relation(fields: [ruleSetId], references: [id])
  results          IntlExamResult[]

  @@index([examFamily, examType])
  @@index([academicYearText])
}

model IntlExamResult {
  id                      String   @id @default(cuid())
  sessionId               String
  ruleSetId               String
  examFamily              String   // CAMBRIDGE_YLE | CAMBRIDGE_MAIN | IELTS | PEARSON_EDEXCEL | CAMBRIDGE_CHECKPOINT
  examType                String   // STARTERS | MOVERS | FLYERS | KET | PET | IELTS | IPRIMARY | ILOWERSECONDARY | PRIMARY_CHECKPOINT | LOWER_SECONDARY_CHECKPOINT
  
  // Liên thông Học sinh SSM + Snapshot lịch sử
  studentId               String?  // FK -> Student.id (nullable khi đang chờ đối soát lịch sử)
  studentCodeSnapshot     String?  // Mã HS gốc SSM / Mã SKL
  studentNameSnapshot     String   // Họ tên chuẩn hóa NFC
  studentDobSnapshot      DateTime?
  campusIdSnapshot        String?  // FK -> Campus.id
  campusCodeSnapshot      String?  // CS1, CS2, CS3, CS4, CS5
  gradeSnapshot           String?  // "1".."12"
  classIdSnapshot         String?
  classNameSnapshot       String?  // "5/1", "12A", "9GAC"
  eduSystemSnapshot       String?  // "Hội nhập", "Song ngữ", "Quốc tế", "Tích hợp"
  academicYearText        String   // "2022-2023", "2023-2024", "2024-2025", "2026-2027"
  examDate                DateTime?
  sittingStatus           String   @default("COMPLETED") // COMPLETED | ABSENT | WITHDRAWN | PENDING_RESULT

  // 1. Nhóm trường chuyên biệt cho Cambridge YLE (Starters / Movers / Flyers)
  yleTotalShields         Int?     // 0..15
  yleResultCode           String?  // "RW4-L5-S5"
  yleSkylineGroup         String?  // "0_6" | "7_9" | "10_14" | "15"
  yleMeetsInternalTarget  Boolean?

  // 2. Nhóm trường chuyên biệt cho Cambridge Main Suite (KET / PET)
  camOverallScale         Int?     // Official Overall Cambridge English Scale (80..170)
  camCalculatedAverage    Float?   // Reference average of 4 skills (for QA comparison only)
  camOfficialGrade        String?  // "GRADE_A" | "GRADE_B" | "GRADE_C" | "LEVEL_A1" | "LEVEL_A2" | "BELOW_THRESHOLD"
  camOfficialStatement    String?  // Raw statement e.g. "Pass at Grade A", "Council of Europe Level A1"
  camCefrLevel            String?  // "A1" | "A2" | "B1" | "B2" | "BELOW_A1"
  camAwardedCertificate   Boolean? // true if >= 100 (KET) or >= 120 (PET)
  camMeetsTargetLevel     Boolean? // true if >= 120 (KET A2) or >= 140 (PET B1)
  camExceedsLevel         Boolean? // true if Grade A (vượt khung B1 cho KET / B2 cho PET)

  // 3. Nhóm trường chuyên biệt cho IELTS
  ieltsOverallBand        Float?   // Official Overall Band (0.0..9.0, step 0.5)
  ieltsCalculatedOverall  Float?   // Official rounded average from 4 skills (for QA check)
  ieltsBandGroup          String?  // "UNDER_4_0" | "4_0_4_5" | "5_0_5_5" | "6_0_6_5" | "7_0_7_5" | "8_0_PLUS"
  ieltsCefrLevel          String?  // "A2" | "B1" | "B2" | "C1" | "C2"
  ieltsStrongestSkill     String?  // "LISTENING" | "READING" | "WRITING" | "SPEAKING" | "TIE"
  ieltsWeakestSkill       String?  // "LISTENING" | "READING" | "WRITING" | "SPEAKING" | "TIE"
  ieltsAttemptNumber      Int      @default(1)
  ieltsIsLatest           Boolean  @default(true)
  ieltsIsHighest          Boolean  @default(true)

  // 4. Trạng thái đầy đủ dữ liệu & đối soát
  dataCompleteness        String   @default("FULL_COMPONENTS") // FULL_COMPONENTS | HISTORICAL_OVERALL_ONLY | PARTIAL_SUBJECTS
  isHistoricalImport      Boolean  @default(false)
  isStudentVerified       Boolean  @default(false)
  importBatchId           String?
  remarks                 String?
  createdById             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  session                 IntlExamSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  ruleSet                 IntlExamRuleSet        @relation(fields: [ruleSetId], references: [id])
  skillResults            IntlExamSkillResult[]
  certificate             IntlCertificateRecord?

  @@index([examFamily, examType, academicYearText])
  @@index([studentId])
  @@index([campusCodeSnapshot, gradeSnapshot, classNameSnapshot])
  @@index([sittingStatus])
  @@index([isStudentVerified])
}

model IntlExamSkillResult {
  id                  String   @id @default(cuid())
  resultId            String
  componentType       String   // "SKILL" (YLE/KET/PET/IELTS) | "SUBJECT" (Pearson/Checkpoint)
  componentCode       String   // "RW" | "LISTENING" | "READING" | "WRITING" | "SPEAKING" | "MATH" | "SCIENCE" | "ESL"
  componentName       String   // "Reading & Writing", "Mathematics", "English as a Second Language"
  scaleUnit           String   // "SHIELD" | "CAMBRIDGE_SCALE" | "IELTS_BAND" | "PEARSON_SCORE" | "CHECKPOINT_50" | "CHECKPOINT_6"
  numericScore        Float?   // Shields (0..5), Scale (80..170), Band (0..9), Pearson Score, Checkpoint Score (0..50)
  maxNumericScore     Float?   // 5, 150, 170, 9.0, 50.0, etc.
  officialBandCode    String?  // Pearson: "P1"|"P2"|"P3"|"S1"|"S2"|"S3"|"S4"; Checkpoint: "UNCLASSIFIED"|"BASIC"|"ASPIRING"|"GOOD"|"HIGH"|"OUTSTANDING"
  officialBandLabel   String?  // Raw label from statement of results
  isHighOutstanding   Boolean? // For Checkpoint: true if HIGH or OUTSTANDING (31-50)
  isLowPerformance    Boolean? // Flag for academic intervention (e.g., Basic/Aspiring or <=2 shields or P1)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  result              IntlExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, componentCode])
  @@index([componentCode, officialBandCode])
  @@index([resultId])
}

model IntlCertificateRecord {
  id                  String    @id @default(cuid())
  resultId            String    @unique
  studentId           String?
  certificateNumber   String?   // Candidate ID / Certificate Reference / TRF Number
  candidateNumber     String?
  centerNumber        String?   // e.g., VNxxx
  issueDate           DateTime?
  expiryDate          DateTime? // Relevant for IELTS (2-year validity reference)
  certificateStatus   String    @default("PENDING") // PENDING | RECEIVED_AT_SCHOOL | ISSUED_TO_STUDENT | DIGITAL_VERIFIED | NOT_AWARDED
  receivedByStudentAt DateTime?
  receivedByName      String?
  fileUrl             String?   // PDF/Image scan of Statement of Results / Certificate
  statementFileUrl    String?   // Secondary attachment (Statement of Results vs Certificate)
  verificationUrl     String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  result              IntlExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([certificateStatus])
  @@index([certificateNumber])
}

model IntlImportBatch {
  id                String   @id @default(cuid())
  batchCode         String   @unique
  fileName          String
  fileHash          String?
  totalSheets       Int      @default(1)
  totalRows         Int      @default(0)
  validRows         Int      @default(0)
  warningRows       Int      @default(0)
  errorRows         Int      @default(0)
  matchedStudents   Int      @default(0)
  unmatchedStudents Int      @default(0)
  status            String   @default("PREVIEW") // PREVIEW | COMMITTED | CANCELLED
  summaryJson       String?
  importedById      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stagingRecords    IntlStagingRecord[]
}

model IntlStagingRecord {
  id                  String   @id @default(cuid())
  batchId             String
  sheetName           String
  rowNumber           Int
  detectedExamFamily  String
  detectedExamType    String
  rawPayloadJson      String   // Original cells from Excel row
  normalizedJson      String   // Parsed & normalized fields + component scores
  matchedStudentId    String?
  matchedStudentCode  String?
  matchedStudentName  String?
  matchConfidence     String   @default("UNMATCHED") // EXACT_CODE | EXACT_NAME_DOB_CLASS | FUZZY_CANDIDATE | HISTORICAL_UNLINKED
  candidateMatchesJson String? // Top 3 candidate students in SSM if fuzzy
  validationStatus    String   @default("VALID") // VALID | WARNING | ERROR | SKIPPED_DRAFT
  validationMessages  String?  // JSON array of warnings/errors
  isCommitted         Boolean  @default(false)
  createdResultId     String?
  createdAt           DateTime @default(now())

  batch               IntlImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, validationStatus])
  @@index([matchConfidence])
}

// ============================================================================
// PHÂN HỆ KHẢO THÍ SỐ ĐỊNH KỲ (DIGITAL TESTING & OMR / LMS PLATFORM)
// ============================================================================

model TestingPeriod {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  academicYearId String
  semester       String   @default("HK1")
  examType       String   @default("MIDTERM")
  programType    String   @default("MOET")
  campusId       String?
  gradeLevels    String
  startDate      DateTime
  endDate        DateTime
  isMakeup       Boolean  @default(false)
  parentPeriodId String?
  status         String   @default("DRAFT")
  description    String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subjectExams   TestingSubjectExam[]

  @@index([academicYearId, semester])
}

model TestingSubjectExam {
  id                 String    @id @default(cuid())
  periodId           String
  subjectId          String
  gradeLevel         String
  campusId           String?
  examFormat         String    @default("PAPER_OMR")
  durationMinutes    Int       @default(60)
  maxScore           Float     @default(10.0)
  mcqWeight          Float     @default(7.0)
  essayWeight        Float     @default(3.0)
  moodleCourseId     Int?
  moodleQuizId       Int?
  moodleCmId         Int?
  moodleSyncStatus   String    @default("NOT_LINKED")
