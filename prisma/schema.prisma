generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:/tmp/skyline_dev.db"
}

model User {
  id                               String                                      @id @default(cuid())
  fullName                         String
  email                            String                                      @unique
  passwordHash                     String
  role                             String                                      @default("PARENT")
  status                           String                                      @default("ACTIVE")
  createdAt                        DateTime                                    @default(now())
  updatedAt                        DateTime                                    @updatedAt
  inputAssessmentPeriods           InputAssessmentPeriod[]                     @relation("PeriodAssignee")
  preschoolInputAssessmentPeriods  PreschoolInputAssessmentPeriod[]            @relation("PreschoolPeriodAssignee")
  preschoolInputAssessmentBatches  PreschoolInputAssessmentBatch[]             @relation("PreschoolBatchAssignee")
  InputAssessmentTeacherAssignment InputAssessmentTeacherAssignment[]
  preschoolTeacherAssignments      PreschoolInputAssessmentTeacherAssignment[]
  preschoolDelegatedAssignments    PreschoolInputAssessmentTeacherAssignment[] @relation("PreschoolAssignmentDelegated")
  notifications                    Notification[]
  parent                           Parent?
  taskAttachments                  TaskAttachment[]                            @relation("TaskAttachments")
  taskComments                     TaskComment[]                               @relation("TaskComments")
  teacher                          Teacher?
  //  student                          Student?
  weeklyReports                    WeeklyReport[]
  receivedTasks                    WorkTask[]                                  @relation("TaskAssignee")
  assignedTasks                    WorkTask[]                                  @relation("TaskAssigner")
  campusAssignments                UserCampusAssignment[]
  inputAssessmentBatches           InputAssessmentBatch[]                      @relation("BatchAssignee")
  studentTransfers                 StudentTransfer[]
  managedCampuses                  Campus[]                                    @relation("CampusManager")
  featureBadges                   UserFeatureBadge[]
  competencyImportBatches         ImportBatch[]
  pushSubscriptions                PushSubscription[]
  userPreference                   UserPreference?
  deviceSessions                   DeviceSession[]
  inputAssessmentSessionExaminers  InputAssessmentSessionExaminer[]
  preschoolInputAssessmentSessionExaminers PreschoolInputAssessmentSessionExaminer[]
}

model Parent {
  id          String              @id @default(cuid())
  userId      String              @unique
  parentCode  String              @unique
  parentName  String
  email       String?
  phone       String?
  status      String              @default("ACTIVE")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  students    ParentStudentLink[]
  surveyForms SurveyForm[]
}

model Teacher {
  id                     String                    @id @default(cuid())
  proposedSupportTargets LearningSupportTarget[]   @relation(name: "ProposerRelation")
  userId                 String                    @unique
  teacherCode            String                    @unique
  teacherName            String
  email                  String?
  phone                  String?
  homeroomClass          String?
  campusId               String
  status                 String                    @default("ACTIVE")
  position               String                    @default("GV")
  positions              String?
  dateOfBirth            DateTime?
  departmentId           String?
  mainSubjectId          String?
  mainSubjectRel         Subject?                  @relation("teacherMainSubject", fields: [mainSubjectId], references: [id])
  departmentRel          Department?               @relation(fields: [departmentId], references: [id])
  departmentAssignments  TeacherDepartmentAssignment[]
  divisionAssignments    TeacherDivisionAssignment[]
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus                 Campus                    @relation(fields: [campusId], references: [id])
  classes                TeacherClassAssignment[]
  TeachingAssignment     TeachingAssignment[]
  hostObservationSlots   ObservationSlot[]         @relation("HostTeacher")
  observerRegistrations  ObservationRegistration[] @relation("ObserverTeacher")

  academicYearTargets        TeacherAcademicYearTarget[]
  achievements               Achievement[]
  achievementRequests        StudentAchievementRequest[]
  activityRecords            ActivityRecord[]
  learningSupportAssignments LearningSupportAssignment[]
  academicConsultationLogs   AcademicConsultationLog[]
  studentHelpRequests        StudentHelpRequest[]
  teacherChallenges          TeacherChallenge[]
  challengeObservations      ChallengeObservation[]
  wowMoments                 AiGrowthWowMoment[]
  inspirationPointsLogs      InspirationPointsLog[]
  growthStreak               TeacherGrowthStreak?
  inspirationShares          InspirationShare[]
  challengeAdoptions         ChallengeAdoption[]
  badges                     TeacherBadge[]
  ctqtPrimaryAssignments     CtqtTeachingAssignment[] @relation("CtqtPrimaryTeacher")
  ctqtDelegatedAssignments   CtqtTeachingAssignment[] @relation("CtqtDelegatedTeacher")
  specialAssignments         SpecialTeachingAssignment[]
  signatureProfile           TeacherSignatureProfile?

  @@index([campusId])
  @@index([departmentId])
}

model Campus {
  surveyPeriods                   SurveyPeriod[]
  id                              String                           @id @default(cuid())
  campusCode                      String                           @unique
  campusName                      String
  address                         String?
  status                          String                           @default("ACTIVE")
  managerId                       String?
  manager                         User?                            @relation("CampusManager", fields: [managerId], references: [id], onDelete: SetNull)
  classes                         Class[]
  inputAssessmentPeriods          InputAssessmentPeriod[]
  preschoolInputAssessmentPeriods PreschoolInputAssessmentPeriod[]
  preschoolInputAssessmentBatches PreschoolInputAssessmentBatch[]
  students                        Student[]
  summaries                       SummaryByCampus[]
  surveyForms                     SurveyForm[]
  teachers                        Teacher[]
  userAssignments                 UserCampusAssignment[]
  inputAssessmentBatches          InputAssessmentBatch[]
  inputAssessmentSessions         InputAssessmentSession[]
  preschoolInputAssessmentSessions PreschoolInputAssessmentSession[]
}

model AcademicYear {
  id                              String                           @id @default(cuid())
  name                            String
  startDate                       DateTime
  endDate                         DateTime
  status                          String                           @default("ACTIVE")
  isOff                           Boolean                          @default(false)
  theme                           String?
  pillars                         String?
  yearThemes                      String?
  assessmentConfigs               AssessmentConfig[]
  preschoolAssessmentConfigs      PreschoolAssessmentConfig[]
  classes                         Class[]
  educationSystems                EducationSystem[]
  inputAssessmentPeriods          InputAssessmentPeriod[]
  inputAssessmentSessions         InputAssessmentSession[]
  preschoolInputAssessmentPeriods PreschoolInputAssessmentPeriod[]
  preschoolInputAssessmentSessions PreschoolInputAssessmentSession[]
  students                        Student[]
  subjectQuotas                   SubjectQuota[]
  surveyForms                     SurveyForm[]
  surveyPeriods                   SurveyPeriod[]
  teachingAssignments             TeachingAssignment[]
  studentCodeMappings             StudentCodeMapping[]
  weeklyReports                   WeeklyReport[]
  workTasks                       WorkTask[]
  teacherTargets                  TeacherAcademicYearTarget[]
  observationSlots                ObservationSlot[]
  exams                           Exam[]
  examCategories                  ExamCategory[]
  examRounds                      ExamRound[]
  achievements                    Achievement[]
  achievementRequests             StudentAchievementRequest[]
  achievementCategories           AchievementCategory[]
  achievementLevels               AchievementLevel[]
  activityRecords                 ActivityRecord[]
  learningSupportTargets          LearningSupportTarget[]
  learningSupportAssignments      LearningSupportAssignment[]
  learningSupportOutcomeConfigs   LearningSupportOutcomeConfig[]
  learningCommitments             StudentLearningCommitment[]
  subjectGradeConfigs             SubjectGradeConfig[]
  inputAssessmentGradeConfigs     InputAssessmentGradeConfig[]
  subjectGradeEntries             SubjectGradeEntry[]
  careerOrientations             StudentCareerOrientation[]
  studentGoals                   StudentGoal[]
  goalUnlocks                   StudentGoalUnlock[]
  consultationLogs               AcademicConsultationLog[]
  reflections                    StudentReflection[]
  helpRequests                   StudentHelpRequest[]
  advisoryStatuses               StudentAdvisoryStatus[]
  goalTrackings                  StudentGoalTrackingLog[]
  termEvaluations                StudentTermEvaluation[]
  competencyImportBatches        ImportBatch[]
  competencyAssessments          StudentCompetencyAssessment[]
  competencySummaries            StudentSubjectCompetencySummary[]
  ctqtTeachingAssignments        CtqtTeachingAssignment[]
  ctqtGradeEntries               CtqtGradeEntry[]
  ctqtCompetencyEntries          CtqtCompetencyEntry[]
  signableDocuments              SignableDocument[]
}

model Class {
  id                   String                            @id @default(cuid())
  classCode            String                            @unique
  className            String
  level                String                            @default("Tieu hoc")
  grade                String                            @default("")
  campusId             String
  academicYearId       String
  homeroomTeacherId    String?
  status               String                            @default("ACTIVE")
  educationSystem      String?                           @default("")
  campus               Campus                            @relation(fields: [campusId], references: [id])
  academicYear         AcademicYear                      @relation(fields: [academicYearId], references: [id])
  students             Student[]
  summaries            SummaryByClass[]
  surveyForms          SurveyForm[]
  teachers             TeacherClassAssignment[]
  teachingAssignments  TeachingAssignment[]
  generalEnrollments   InputAssessmentStudent[]          @relation("GeneralEnrollmentClass")
  preschoolEnrollments PreschoolInputAssessmentStudent[] @relation("PreschoolEnrollmentClass")
  subjectGradeEntries  SubjectGradeEntry[]
  ctqtTeachingAssignments CtqtTeachingAssignment[]
  ctqtGradeEntries       CtqtGradeEntry[]
  ctqtCompetencyEntries  CtqtCompetencyEntry[]
  specialAssignments     SpecialTeachingAssignment[]
  signableDocuments      SignableDocument[]
  achievementRequests    StudentAchievementRequest[]

  @@index([campusId])
  @@index([academicYearId])
}

model TeacherClassAssignment {
  id          String  @id @default(cuid())
  teacherId   String
  classId     String
  roleInClass String?
  status      String  @default("ACTIVE")
  class       Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher     Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId])
}

model Student {
  id                     String                      @id @default(cuid())
  studentCode            String
  studentName            String
  englishName            String?
  //  userId         String?             @unique
  classId                String
  campusId               String
  academicYearId         String
  status                 String                      @default("ACTIVE")
  dateOfBirth            DateTime?
  gender                 String?
  studentType            String                      @default("CHINH_KHOA")
  studentTypeNote        String?
  convertedAt            DateTime?
  conversionReason       String?
  convertedBy            String?
  parents                ParentStudentLink[]
  academicYear           AcademicYear                @relation(fields: [academicYearId], references: [id])
  campus                 Campus                      @relation(fields: [campusId], references: [id])
  class                  Class                       @relation(fields: [classId], references: [id])
  surveyForms            SurveyForm[]
  studentTransfers       StudentTransfer[]
  //  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  exams                  ExamStudent[]
  achievements           StudentAchievement[]
  achievementRequests    StudentAchievementRequest[]
  careerOrientations     StudentCareerOrientation[]
  projectExperiences     StudentProjectExperience[]
  learningCommitments    StudentLearningCommitment[]
  highlightComments      StudentHighlightComment[]
  activityParticipants   ActivityParticipant[]
  learningSupportTargets LearningSupportTarget[]
  termScores             StudentTermScore[]
  termSummaries          StudentTermSummary[]
  subjectGradeEntries    SubjectGradeEntry[]

  // Co Van Hoc Tap & Ho So 360
  goals                  StudentGoal[]
  goalUnlocks            StudentGoalUnlock[]
  consultationLogs       AcademicConsultationLog[]
  reflections            StudentReflection[]
  helpRequests           StudentHelpRequest[]
  advisoryStatuses       StudentAdvisoryStatus[]
  goalTrackings          StudentGoalTrackingLog[]
  termEvaluations        StudentTermEvaluation[]
  competencyAssessments  StudentCompetencyAssessment[]
  competencySummaries    StudentSubjectCompetencySummary[]
  photo                  StudentPhoto?
  ctqtGradeEntries       CtqtGradeEntry[]
  ctqtCompetencyEntries  CtqtCompetencyEntry[]
  specialGradeEntries    SpecialGradeEntry[]
  specialProjectMembers  SpecialProjectMember[]
  signableDocuments      SignableDocument[]

  @@unique([studentCode, academicYearId])
  @@index([classId])
  @@index([campusId])
  @@index([academicYearId])
}

model StudentPhoto {
  id          String   @id @default(cuid())
  studentId   String   @unique
  photoData   String
  contentType String   @default("image/jpeg")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ParentStudentLink {
  id           String  @id @default(cuid())
  parentId     String
  studentId    String
  relationship String?
  status       String  @default("ACTIVE")
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent       Parent? @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model SurveyPeriod {
  id              String            @id @default(cuid())
  code            String            @unique
  name            String
  academicYearId  String
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean           @default(false)
  status          String            @default("ACTIVE")
  campusSummaries SummaryByCampus[]
  classSummaries  SummaryByClass[]
  systemSummaries SummarySystem?
  surveyForms     SurveyForm[]
  targetAudience  String            @default("PHHS")
  academicYear    AcademicYear      @relation(fields: [academicYearId], references: [id])
  campusId        String?
  campus          Campus?           @relation(fields: [campusId], references: [id])
  questions       SurveyQuestion[]

  @@index([academicYearId])
  @@index([campusId])
}

model SurveySection {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  sortOrder Int              @default(0)
  status    String           @default("ACTIVE")
  parentId  String?
  parent    SurveySection?   @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  SurveySection[]  @relation("ParentChildren")
  questions SurveyQuestion[]

  @@index([parentId])
}

model SurveyQuestion {
  id             String           @id @default(cuid())
  code           String           @unique
  questionText   String
  sectionId      String?
  surveyPeriodId String?
  questionType   String
  ratingScaleMin Int?             @default(1)
  ratingScaleMax Int?             @default(5)
  options        String?
  weight         Float            @default(1.0)
  isRequired     Boolean          @default(true)
  isActive       Boolean          @default(true)
  sortOrder      Int              @default(0)
  surveyPeriod   SurveyPeriod?    @relation(fields: [surveyPeriodId], references: [id])
  section        SurveySection?   @relation(fields: [sectionId], references: [id])
  responses      SurveyResponse[]

  @@index([sectionId])
  @@index([surveyPeriodId])
}

model SurveyForm {
  id                  String           @id @default(cuid())
  surveyPeriodId      String
  parentId            String?
  studentId           String
  classId             String
  campusId            String
  academicYearId      String
  submissionDateTime  DateTime         @default(now())
  submittedByEmail    String?
  overallAverageScore Float?
  npsScoreRaw         Int?
  npsCategory         String?
  status              String           @default("DRAFT")
  surveyPeriod        SurveyPeriod     @relation(fields: [surveyPeriodId], references: [id], onDelete: Cascade)
  parent              Parent?          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student             Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class               Class            @relation(fields: [classId], references: [id])
  campus              Campus           @relation(fields: [campusId], references: [id])
  academicYear        AcademicYear     @relation(fields: [academicYearId], references: [id])
  responses           SurveyResponse[]
  // Note: For students, we might need another check or just rely on this if student surveys have parentId=null

  @@unique([parentId, studentId, surveyPeriodId]) // For parents
  @@index([studentId])
  @@index([classId])
  @@index([campusId])
  @@index([academicYearId])
}

model SurveyResponse {
  id                      String         @id @default(cuid())
  formId                  String
  questionId              String
  numericScore            Int?
  textAnswer              String?
  choiceAnswer            String?
  calculatedWeightedScore Float?
  createdAt               DateTime       @default(now())
  question                SurveyQuestion @relation(fields: [questionId], references: [id])
  form                    SurveyForm     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([questionId])
}

model SummaryByClass {
  id                       String       @id @default(cuid())
  surveyPeriodId           String
  classId                  String
  totalStudents            Int          @default(0)
  surveyedStudents         Int          @default(0)
  notSurveyedStudents      Int          @default(0)
  completionRate           Float        @default(0)
  averageSatisfactionScore Float?       @default(0)
  promoterCount            Int          @default(0)
  passiveCount             Int          @default(0)
  detractorCount           Int          @default(0)
  npsValue                 Float?       @default(0)
  updatedAt                DateTime     @updatedAt
  class                    Class        @relation(fields: [classId], references: [id])
  surveyPeriod             SurveyPeriod @relation(fields: [surveyPeriodId], references: [id], onDelete: Cascade)

  @@unique([surveyPeriodId, classId])
}

model SummaryByCampus {
  id                       String       @id @default(cuid())
  surveyPeriodId           String
  campusId                 String
  totalStudents            Int          @default(0)
  surveyedStudents         Int          @default(0)
  notSurveyedStudents      Int          @default(0)
  completionRate           Float        @default(0)
  averageSatisfactionScore Float?       @default(0)
  promoterCount            Int          @default(0)
  passiveCount             Int          @default(0)
  detractorCount           Int          @default(0)
  npsValue                 Float?       @default(0)
  updatedAt                DateTime     @updatedAt
  campus                   Campus       @relation(fields: [campusId], references: [id])
  surveyPeriod             SurveyPeriod @relation(fields: [surveyPeriodId], references: [id], onDelete: Cascade)

  @@unique([surveyPeriodId, campusId])
}

model SummarySystem {
  id                       String       @id @default(cuid())
  surveyPeriodId           String       @unique
  totalStudents            Int          @default(0)
  surveyedStudents         Int          @default(0)
  notSurveyedStudents      Int          @default(0)
  completionRate           Float        @default(0)
  averageSatisfactionScore Float?       @default(0)
  promoterCount            Int          @default(0)
  passiveCount             Int          @default(0)
  detractorCount           Int          @default(0)
  npsValue                 Float?       @default(0)
  updatedAt                DateTime     @updatedAt
  surveyPeriod             SurveyPeriod @relation(fields: [surveyPeriodId], references: [id], onDelete: Cascade)
}

model Notification {
  id           String    @id @default(cuid())
  userId       String
  title        String
  message      String
  isRead       Boolean   @default(false)
  link         String?
  createdAt    DateTime  @default(now())
  type         String?   @default("INFORMATION")
  category     String?   @default("GENERAL")
  priority     String?   @default("NORMAL")
  sourceModule String?
  sourceId     String?
  expiredAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

model Subject {
  id            String   @id @default(cuid())
  subjectCode   String   @unique
  subjectName   String
  studyPrograms String?  @default("")
  level         String?  @default("ALL")
  description   String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships for Parent-Child subjects
  parentId      String?
  parentSubject Subject?  @relation("SubSubjects", fields: [parentId], references: [id], onDelete: SetNull)
  subSubjects   Subject[] @relation("SubSubjects")

  // Subject category: MOET, SKL, INTERNATIONAL
  category String? @default("MOET")
  evaluationType String? @default("SCORE")

  quotas                     SubjectQuota[]
  mainTeachers               Teacher[]                   @relation("teacherMainSubject")
  assignments                TeachingAssignment[]
  learningSupportAssignments LearningSupportAssignment[]
  StudentTermScore           StudentTermScore[]
  subjectGradeConfigs        SubjectGradeConfig[]
  subjectGradeEntries        SubjectGradeEntry[]
  competencies               SubjectCompetency[]
  aliases                    SubjectAlias[]
  competencyAssessments      StudentCompetencyAssessment[]
  competencySummaries        StudentSubjectCompetencySummary[]
  specialSubjects            SpecialSubject[]
}

model TeachingAssignment {
  id             String       @id @default(cuid())
  teacherId      String
  classId        String
  subjectId      String
  academicYearId String
  semester       Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  teacher        Teacher      @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, classId, subjectId, academicYearId, semester])
}

model SubjectQuota {
  id             String       @id @default(cuid())
  subjectId      String
  academicYearId String
  studyProgram   String       @default("DEFAULT")
  quota          Float        @default(0)
  quotaPrimary   Float        @default(0)
  quotaMiddle    Float        @default(0)
  quotaHigh      Float        @default(0)
  quotaG1        Float        @default(0)
  quotaG2        Float        @default(0)
  quotaG3        Float        @default(0)
  quotaG4        Float        @default(0)
  quotaG5        Float        @default(0)
  quotaG6        Float        @default(0)
  quotaG7        Float        @default(0)
  quotaG8        Float        @default(0)
  quotaG9        Float        @default(0)
  quotaG10       Float        @default(0)
  quotaG11       Float        @default(0)
  quotaG12       Float        @default(0)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, academicYearId, studyProgram])
}

model Role {
  code        String       @id
  name        String
  description String?
  isSystem    Boolean      @default(false)
  permissions Permission[]
}

model Permission {
  id        String  @id @default(cuid())
  roleCode  String
  module    String
  canRead   Boolean @default(false)
  canCreate Boolean @default(false)
  canUpdate Boolean @default(false)
  canDelete Boolean @default(false)
  role      Role    @relation(fields: [roleCode], references: [code], onDelete: Cascade)

  @@unique([roleCode, module])
}

model WorkTask {
  id               String           @id @default(cuid())
  category         String
  title            String
  description      String?
  assignedToRole   String           @default("KT_DBCL")
  assignedToUserId String?
  assignedById     String
  startDate        DateTime
  endDate          DateTime
  progress         String           @default("PENDING")
  acceptanceStatus String           @default("WAITING_CONFIRMATION")
  acceptedAt       DateTime?
  rejectionReason  String?
  month            Int?
  academicYearId   String?
  isImportant      Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  staffNote        String?
  staffUpdatedAt   DateTime?
  collaborators    String?
  taskGroupId      String?
  department       String?          @default("KT&ĐBCL")
  priority         String?          @default("MEDIUM")
  completedAt      DateTime?
  attachments      TaskAttachment[]
  comments         TaskComment[]
  assignedToUser   User?            @relation("TaskAssignee", fields: [assignedToUserId], references: [id])
  assignedBy       User             @relation("TaskAssigner", fields: [assignedById], references: [id])
  academicYear     AcademicYear?    @relation(fields: [academicYearId], references: [id])
  taskGroup        TaskGroup?       @relation(fields: [taskGroupId], references: [id])
}

model TaskComment {
  id               String    @id @default(cuid())
  taskId           String
  userId           String
  content          String
  commentType      String?   @default("GENERAL")
  actionAssigneeId String?
  actionDueDate    DateTime?
  actionStatus     String?   @default("NONE")
  mentionedUserIds String?
  createdAt        DateTime  @default(now())
  user             User      @relation("TaskComments", fields: [userId], references: [id])
  task             WorkTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAttachment {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  fileName    String
  fileData    String
  fileSize    Int      @default(0)
  contentType String   @default("")
  createdAt   DateTime @default(now())
  user        User     @relation("TaskAttachments", fields: [userId], references: [id])
  task        WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model InputAssessmentPeriod {
  id                               String                             @id @default(cuid())
  code                             String                             @unique
  name                             String
  academicYearId                   String
  campusId                         String?
  assignedUserId                   String?
  startDate                        DateTime?
  endDate                          DateTime?
  description                      String?
  status                           String                             @default("ACTIVE")
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @updatedAt
  batches                          InputAssessmentBatch[]
  academicYear                     AcademicYear                       @relation(fields: [academicYearId], references: [id])
  campus                           Campus?                            @relation(fields: [campusId], references: [id])
  assignedUser                     User?                              @relation("PeriodAssignee", fields: [assignedUserId], references: [id])
  students                         InputAssessmentStudent[]
  sessions                         InputAssessmentSession[]
  InputAssessmentTeacherAssignment InputAssessmentTeacherAssignment[]
}

model InputAssessmentBatch {
  id                               String                             @id @default(cuid())
  periodId                         String
  batchNumber                      Int
  name                             String
  startDate                        DateTime
  endDate                          DateTime
  status                           String                             @default("ACTIVE")
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @updatedAt
  campusId                         String?
  assignedUserId                   String?
  campus                           Campus?                            @relation(fields: [campusId], references: [id])
  assignedUser                     User?                              @relation("BatchAssignee", fields: [assignedUserId], references: [id])
