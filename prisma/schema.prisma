  sentAt              DateTime?
  createdAt           DateTime                    @default(now())

  notification        SsmNotification             @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient           SsmNotificationRecipient    @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([notificationId, channel, status])
  @@index([recipientId])
  @@map("ssm_notification_deliveries")
}

