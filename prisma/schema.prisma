model SpecialProjectMember {
  id               String   @id @default(cuid())
  groupId          String
  studentId        String
  roleInGroup      String   @default("MEMBER")
  individualEval   String?
  individualNote   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  group            SpecialProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
