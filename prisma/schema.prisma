  title              String
  meetingType        String                     @default("DINH_KY") // DINH_KY, CHUYEN_DE, DOT_XUAT, CA_NHAN
  academicYearId     String
  semester           String                     @default("HK1") // HK1, HK2, CA_NAM
  campusId           String
  grade              String?
  level              String?
  startTime          DateTime
  endTime            DateTime
  location           String?
  onlineLink         String?
  agenda             String?
  contentSummary     String?
  hostUserId         String
  hostName           String
  plannerUserId      String
  plannerName        String
  status             String                     @default("DRAFT") // DRAFT, PENDING_APPROVAL, PUBLISHED, IN_PROGRESS, COMPLETED, CANCELLED
  rsvpOpenAt         DateTime?
  rsvpCloseAt        DateTime?
  checkInOpenAt      DateTime?
  checkInCloseAt     DateTime?
  allowPreQuestions  Boolean                    @default(true)
  publishedAt        DateTime?
  approvedByUserId   String?
  approvedByName     String?
  approvedAt         DateTime?
