model TeacherSignatureProfile {
  id                  String   @id @default(cuid())
  teacherId           String   @unique
  provider            String   @default("NOT_CONFIGURED") // VNPT_SMARTCA, VIETTEL_CA, MISA_ESIGN, FPT_CA, MOCK_SANDBOX
  connectionStatus    String   @default("NOT_CONNECTED") // NOT_CONNECTED, CONNECTED, EXPIRED, REVOKED
  subjectDn           String?
  serialNumber        String?
  issuer              String?
  validFrom           DateTime?
  validTo             DateTime?
  lastVerifiedAt      DateTime?
  visualAppearanceUrl String?  // Base64 PNG or path
  appearanceType      String   @default("DRAWN") // DRAWN | UPLOADED
  appearanceVersion   Int      @default(1)
  signatureRoleText   String?  // e.g. "Giáo viên Bộ môn", "Giáo viên Chủ nhiệm"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  teacher             Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([connectionStatus])
  @@map("teacher_signature_profiles")
}

model DigitalSignatureConfig {
  id                     String   @id @default(cuid())
  key                    String   @unique // SYSTEM_CONFIG
  isEnabled              Boolean  @default(true)
  allowedProviders       String   @default("[\"VNPT_SMARTCA\",\"VIETTEL_CA\",\"MISA_ESIGN\",\"FPT_CA\",\"MOCK_SANDBOX\"]")
  activeProvider         String   @default("VNPT_SMARTCA")
  providerSettings       String   @default("{}") // Encrypted / server JSON config
