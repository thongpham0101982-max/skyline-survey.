model SsmNotification {
  id                    String                      @id @default(cuid())
  code                  String                      @unique
  category              String                      @default("EXAM") // EXAM, TEACHER, ACADEMIC_RESULT, SYSTEM, ADVISORY, EXPERIENTIAL, PARENT_MEETING, COMPETENCY
  subType               String                      @default("GENERAL") // EXAM_SCHEDULE, EXAM_LMS_GUIDE, EXAM_SCHEDULE_CHANGE, EXAM_MAKEUP, EXAM_ABSENT, EXAM_RESULT, GVCN_ANNOUNCEMENT, GVBM_STUDY_GUIDE, SYSTEM_NOTICE
  title                 String
  summary               String?
  contentHtml           String
  priority              String                      @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  senderUnit            String                      @default("Ban KT&ĐBCL")
  senderUserId          String
  senderName            String
  senderRole            String                      // KT_DBCL, ADMIN, GVCN, GVBM, SYSTEM
  academicYearId        String?
  campusId              String?
  gradeLevels           String?                     // e.g. "10,11,12"
  classIdsJson          String?                     // JSON array of classIds
  subjectId             String?
  subjectName           String?
  testingPeriodId       String?
  testingPeriodName     String?
  testingSubjectExamId  String?
  testingSessionId      String?
  examScheduleMetaJson  String?                     // JSON snapshot: room, date, startTime, endTime, examFormat, lmsUrl
  beforeChangeJson      String?                     // JSON snapshot before schedule change
  afterChangeJson       String?                     // JSON snapshot after schedule change
  deepLink              String?
  targetRolesJson       String                      @default("[\"PARENT\",\"STUDENT\"]")
  targetScopeJson       String?
  status                String                      @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SCHEDULED, SENDING, PUBLISHED, PARTIALLY_FAILED, CANCELLED, RECALLED
  requiresApproval      Boolean                     @default(false)
  requireAcknowledge    Boolean                     @default(false)
  acknowledgeDeadline   DateTime?
  allowReply            Boolean                     @default(false)
  scheduledAt           DateTime?
  publishedAt           DateTime?
  recalledAt            DateTime?
  recallReason          String?
  idempotencyKey        String?                     @unique
  totalRecipients       Int                         @default(0)
  sentSuccessCount      Int                         @default(0)
  sentFailedCount       Int                         @default(0)
  readCount             Int                         @default(0)
  acknowledgedCount     Int                         @default(0)
  replyCount            Int                         @default(0)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  recipients            SsmNotificationRecipient[]
  deliveries            SsmNotificationDelivery[]
  attachments           SsmNotificationAttachment[]
  approvals             SsmNotificationApproval[]
  readReceipts          SsmNotificationReadReceipt[]
  responses             SsmNotificationResponse[]
  auditLogs             SsmNotificationAuditLog[]

  @@index([category, status, publishedAt])
  @@index([academicYearId, campusId, status])
  @@index([testingPeriodId, testingSubjectExamId])
  @@index([senderUserId, status])
  @@map("ssm_notifications")
}

model SsmNotificationRecipient {
  id                  String                      @id @default(cuid())
  notificationId      String
  recipientUserId     String                      // User.id or STUDENT:<studentId>
  recipientRole       String                      @default("PARENT") // PARENT, STUDENT, TEACHER
  recipientName       String
  recipientEmail      String?
  studentId           String?
  studentName         String?
  studentCode         String?
  classId             String?
  className           String?
  gradeLevel          String?
  campusId            String?
  campusName          String?
  deliveryStatus      String                      @default("SENT") // PENDING, SENT, FAILED, RECALLED
  deliveredAt         DateTime?
  isRead              Boolean                     @default(false)
  readAt              DateTime?
  isAcknowledged      Boolean                     @default(false)
  acknowledgedAt      DateTime?
  acknowledgeNote     String?
  remindedCount       Int                         @default(0)
  lastRemindedAt      DateTime?
  personalMetaJson    String?                     // e.g. seatNumber, candidateNumber, roomName (never exposed to other students)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  notification        SsmNotification             @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  deliveries          SsmNotificationDelivery[]
  readReceipts        SsmNotificationReadReceipt[]
  responses           SsmNotificationResponse[]

  @@unique([notificationId, recipientUserId, studentId])
  @@index([recipientUserId, isRead, createdAt])
  @@index([studentId, recipientRole, createdAt])
  @@index([notificationId, classId, isRead, isAcknowledged])
  @@index([campusId, classId, isRead])
  @@map("ssm_notification_recipients")
}

model SsmNotificationDelivery {
  id                  String                      @id @default(cuid())
  notificationId      String
  recipientId         String
