  @@index([status, visibility, createdAt])
  @@index([authorId])
  @@index([campusId])
  @@map("slc_products")
}

model SlcProductVersion {
  id                      String     @id @default(cuid())
  productId               String
  version                 String
  majorVersion            Int        @default(1)
  releaseNotes            String
  productUrl              String?
  sourceCommentId         String?    // Liên kết bình luận nguồn góp ý
  contributorUserId       String?
  contributorName         String?
  contributorOptOutPublic Boolean    @default(false) // Người góp ý có thể bỏ nhắc tên công khai
  reopenEvaluation        Boolean    @default(false)
  createdById             String
  createdAt               DateTime   @default(now())
  product                 SlcProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([sourceCommentId])
  @@map("slc_product_versions")
}

model SlcProject {
  id                   String               @id @default(cuid())
  postId               String?              @unique
  ownerId              String
  ownerName            String
  campusId             String?
  campusName           String?
  groupId              String?
  linkedIdeaId         String?
  linkedProductIdsJson String               @default("[]")
  title                String
  goal                 String
  description          String
  coverImageUrl        String?
  neededRolesJson      String               @default("[]")
  subjectCodesJson     String               @default("[]")
  gradeLevelsJson      String               @default("[]")
  tagsJson             String               @default("[]")
  status               String               @default("SEEKING_COLLABORATORS") // SEEKING_COLLABORATORS | IN_PROGRESS | HAS_PRODUCT | PAUSED
  visibility           String               @default("SYSTEM") // SYSTEM | CAMPUS | GROUP
  memberCount          Int                  @default(1)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  members              SlcProjectMember[]
  progressUpdates      SlcProjectProgress[]

  @@index([status, visibility, createdAt])
  @@index([ownerId])
  @@index([campusId])
  @@map("slc_projects")
}

model SlcProjectMember {
  id                  String     @id @default(cuid())
  projectId           String
  userId              String
  userName            String
  userAvatar          String?
  campusName          String?
  roleName            String     @default("Cộng sự chuyên môn")
  memberRole          String     @default("CO_AUTHOR") // LEAD | CO_AUTHOR | CONTRIBUTOR
  status              String     @default("PENDING_REQUEST") // PENDING_REQUEST | INVITED | APPROVED | REJECTED | LEFT
  requestMessage      String?
  contributionSummary String?
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  project             SlcProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, status])
  @@index([projectId, status])
  @@map("slc_project_members")
}

model SlcProjectProgress {
  id                String     @id @default(cuid())
  projectId         String
  authorId          String
  authorName        String
  title             String
  content           String
  milestoneStatus   String     @default("IN_PROGRESS")
  attachmentIdsJson String     @default("[]")
  createdAt         DateTime   @default(now())
  project           SlcProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("slc_project_progresses")
}

model SlcReaction {
  id           String   @id @default(cuid())
  targetType   String   // POST | COMMENT
  targetId     String
  postId       String?
  commentId    String?
  userId       String
  userName     String
  reactionType String   @default("USEFUL") // USEFUL | LOVE | INSPIRED | SUPPORT
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([targetType, targetId, userId])
  @@index([targetType, targetId])
  @@index([userId])
  @@map("slc_reactions")
}

model SlcComment {
  id                      String    @id @default(cuid())
  postId                  String
  authorId                String
  authorName              String
  authorAvatar            String?
  authorRole              String?   @default("Giáo viên")
  campusName              String?
  parentId                String?   // Cấp 1 (null) hoặc ID bình luận cấp 1 (giới hạn 2 cấp hiển thị)
  replyToCommentId        String?
  replyToUserId           String?
  replyToUserName         String?
  depth                   Int       @default(0) // 0 hoặc 1
  content                 String
  mentionedUserIdsJson    String    @default("[]")
  attachmentIdsJson       String    @default("[]")
  isEdited                Boolean   @default(false)
  editedAt                DateTime?
  isDeleted               Boolean   @default(false)
  deletedAt               DateTime?
  status                  String    @default("ACTIVE") // ACTIVE | HIDDEN_MODERATION | DELETED
  isPinned                Boolean   @default(false)
  pinnedAt                DateTime?
  pinnedById              String?
  feedbackStatus          String    @default("NONE") // NONE | RECEIVED | IN_PROGRESS | APPLIED | NOT_IMPLEMENTED
  feedbackReason          String?
  feedbackUpdatedAt       DateTime?
  feedbackUpdatedById     String?
  linkedProductVersionId  String?
  contributorAcknowledged Boolean   @default(false)
  contributorOptOutPublic Boolean   @default(false)
  reactionCount           Int       @default(0)
  clientRequestId         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  post                    SlcPost   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([authorId, clientRequestId])
  @@index([postId, parentId, isPinned, createdAt, id])
  @@index([authorId])
  @@map("slc_comments")
}

model SlcSavedItem {
  id         String   @id @default(cuid())
