  delegatedTeacher    Teacher?     @relation("CtqtDelegatedTeacher", fields: [delegatedTeacherId], references: [id], onDelete: SetNull)

  @@unique([academicYearId, semester, classId, subjectCode])
  @@index([classId])
  @@index([primaryTeacherId])
  @@index([delegatedTeacherId])
}

model CtqtGradeEntry {
  id                  String   @id @default(cuid())
  academicYearId      String
  semester            Int      @default(1)
  classId             String
  studentId           String
  subjectCode         String   // ENG, SCI, MATH, GLOBAL_STUDIES, AE, IELTS, AR
  
