  psychologyReferralStatus String?   @default("NONE") // NONE, REQUESTED, COMPLETED
  psychologyReferralReason String?
  psychologyTeacherId      String?
  psychologyTeacherName    String?
  psychologyData           String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([studentId])
  @@index([academicYearId])
}

// ==========================================
// MODULE: SKY-LINE ALUMNI (CỰU HỌC SINH)
