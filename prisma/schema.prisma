  @@index([gradeEntryId])
  @@index([actorUserId])
}

model SpecialTeachingLog {
  id               String   @id @default(cuid())
  assignmentId     String
  lessonId         String
  taughtDate       DateTime @default(now())
  completedPeriods Int      @default(1)
  notes            String?
  attendanceCount  Int?
