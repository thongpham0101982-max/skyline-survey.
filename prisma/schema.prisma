  title                          String
  content                        String
  verifiedRootCause              String
  actionPlan                     String
  assigneeUserId                 String
  assigneeName                   String?
  assignedByUserId               String
  dueDate                        DateTime
  evidenceUrl                    String?
  evidenceNote                   String?
  status                         String          @default("OPEN") // OPEN, IN_PROGRESS, PENDING_VERIFICATION, VERIFIED_EFFECTIVE, NEEDS_FOLLOWUP, CLOSED
  verificationResult             String?
  verifiedByUserId               String?
  verifiedAt                     DateTime?
  postImprovementEffectiveness   String?
  recurrenceCount                Int             @default(0)
