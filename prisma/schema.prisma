  description      String?
  productUrl       String?
  groupScore       String?
  status           String   @default("IN_PROGRESS")
  activityRecordId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignment       SpecialTeachingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  lesson           SpecialLesson?            @relation(fields: [lessonId], references: [id], onDelete: SetNull)
