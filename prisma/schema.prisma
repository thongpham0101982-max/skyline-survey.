  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
  @@map("slc_saved_items")
}

model SlcFollow {
  id                String   @id @default(cuid())
  followerId        String
  targetType        String   // USER | POST | GROUP | PROJECT
  targetId          String
  muteNotifications Boolean  @default(false)
