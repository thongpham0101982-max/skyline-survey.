// ============================================================================
// PHÂN HỆ PHỐI HỢP GIÁO DỤC & CHẤT LƯỢNG PHẢN HỒI (EDUCATIONAL COORDINATION & QA)
// ============================================================================

model CommunicationThread {
  id                  String                     @id @default(cuid())
  threadCode          String                     @unique
  threadType          String                     @default("PARENT_GVCN") // PARENT_GVCN, PARENT_GVBM, GVCN_GVBM_COORD, ESCALATED_SUPPORT
  academicYearId      String
  campusId            String
  classId             String
  studentId           String
  parentId            String?
  teacherId           String
  subjectId           String?
  assignmentId        String?
  assignmentType      String?                    // HOMEROOM, MOET, CTQT, SPECIAL
  topic               String                     // 1..7 standard topics
  subjectTitle        String
  status              String                     @default("NEW") // NEW, READ, IN_DISCUSSION, ARCHIVED
  visibility          String                     @default("PRIVATE") // PRIVATE, SHARED_WITH_GVCN, ESCALATED_QA
  priority            String                     @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  slaDueAt            DateTime?
  firstRespondedAt    DateTime?
  isOnTime            Boolean?
  lastMessageAt       DateTime                   @default(now())
  lastMessagePreview  String?
  unreadCountParent   Int                        @default(0)
  unreadCountTeacher  Int                        @default(0)
  createdByUserId     String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  messages            CommunicationMessage[]
  participants        CommunicationParticipant[]
  cases               CommunicationCase[]
  attachments         CommunicationAttachment[]

  @@index([academicYearId, campusId])
  @@index([classId, studentId])
  @@index([teacherId, status])
  @@index([parentId, status])
  @@index([subjectId])
  @@map("communication_threads")
}

model CommunicationMessage {
  id                  String                     @id @default(cuid())
  threadId            String
  senderUserId        String
  senderName          String
  senderRole          String                     // PARENT, GVCN, GVBM, TTCM, QLCM, KT_DBCL, SYSTEM
  messageType         String                     @default("TEXT") // TEXT, SYSTEM_LOG, CASE_UPDATE, COORDINATION_NOTE
  content             String
  isInternalNote      Boolean                    @default(false)
  clientMessageId     String?                    @unique
  readByJson          String                     @default("[]")
  createdAt           DateTime                   @default(now())

  thread              CommunicationThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  attachments         CommunicationAttachment[]

  @@index([threadId, createdAt])
  @@index([senderUserId])
  @@map("communication_messages")
}

model CommunicationParticipant {
  id                  String                     @id @default(cuid())
  threadId            String
  userId              String
  userName            String?
  role                String                     // PARENT, GVCN, GVBM, TTCM, QLCM, KT_DBCL
  accessScope         String                     @default("FULL") // FULL, SUMMARY_ONLY, FROM_JOIN_DATE
  lastReadAt          DateTime?
  isMuted             Boolean                    @default(false)
  joinedAt            DateTime                   @default(now())

  thread              CommunicationThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, role])
  @@map("communication_participants")
}

model CommunicationCase {
  id                      String                      @id @default(cuid())
  caseCode                String                      @unique
  threadId                String?
  academicYearId          String
  campusId                String
  classId                 String
  studentId               String
  subjectId               String?
  parentId                String?
  teacherId               String?
  departmentId            String?
  createdByUserId         String
  requesterRole           String                      // PARENT, GVCN, GVBM, KT_DBCL
  assignedToUserId        String
  assignedToName          String?
  assignedRole            String                      // GVCN, GVBM, TTCM, QLCM, KT_DBCL
  category                String                      // 1..7 standard topics
  title                   String
  description             String
  priority                String                      @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status                  String                      @default("NEW") // NEW, ASSIGNED, IN_PROGRESS, WAITING_INFO, RESOLVED, COMPLETED, REOPENED
  slaTargetHours          Int                         @default(16)
  slaDueAt                DateTime
  firstResponseAt         DateTime?
  resolvedAt              DateTime?
  completedAt             DateTime?
  reopenedCount           Int                         @default(0)
  isOverdue               Boolean                     @default(false)
  isResolvedOnTime        Boolean?
  supportPlanMeasures     String?
  supportProgressNote     String?
  supportOutcomeProposal  String?                     // CONTINUE, COMPLETE, ESCALATE
  resolutionSummary       String?
  verifiedConclusion      String?
  linkedSupportTargetId   String?
  parentConfirmedAt       DateTime?
  reopenReason            String?
  isPrivateContent        Boolean                     @default(false)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  thread                  CommunicationThread?        @relation(fields: [threadId], references: [id], onDelete: SetNull)
  history                 CommunicationCaseHistory[]
  attachments             CommunicationAttachment[]
  satisfaction            CommunicationSatisfaction?

  @@index([academicYearId, campusId, status])
  @@index([classId, studentId])
  @@index([assignedToUserId, status])
  @@index([teacherId, status])
  @@index([parentId, status])
  @@index([slaDueAt, status])
  @@map("communication_cases")
}

model CommunicationCaseHistory {
  id                  String                     @id @default(cuid())
  caseId              String
  actorUserId         String
  actorName           String
  actorRole           String
  action              String                     // CREATE, ASSIGN, STATUS_CHANGE, FORWARD, UPDATE_PLAN, RESOLVE, CONFIRM, REOPEN, SLA_REMINDER
  fromStatus          String?
  toStatus            String?
  fromAssigneeId      String?
  toAssigneeId        String?
  note                String?
  createdAt           DateTime                   @default(now())

  caseRecord          CommunicationCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("communication_case_history")
}

model CommunicationAttachment {
  id                  String                     @id @default(cuid())
  threadId            String?
  messageId           String?
  caseId              String?
  uploadedByUserId    String
  fileName            String
  fileType            String
  fileSize            Int
  fileUrl             String
  checksum            String?
  isSafe              Boolean                    @default(true)
  createdAt           DateTime                   @default(now())

  thread              CommunicationThread?       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message             CommunicationMessage?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  caseRecord          CommunicationCase?         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([messageId])
  @@index([caseId])
  @@map("communication_attachments")
}

model CommunicationNotification {
  id                  String                     @id @default(cuid())
  userId              String
  threadId            String?
  caseId              String?
  notificationType    String                     // NEW_MESSAGE, CASE_ASSIGNED, SLA_DUE_SOON, SLA_OVERDUE, CASE_RESOLVED, CASE_REOPENED, SURVEY_INVITE, IMPROVEMENT_ASSIGNED
  title               String
  body                String
  linkUrl             String?
  isRead              Boolean                    @default(false)
  readAt              DateTime?
  createdAt           DateTime                   @default(now())

  @@index([userId, isRead, createdAt])
  @@map("communication_notifications")
}

model CommunicationSatisfaction {
  id                  String                     @id @default(cuid())
  caseId              String                     @unique
  threadId            String?
  parentId            String
  studentId           String
  teacherId           String?
  academicYearId      String
  campusId            String
  classId             String
  subjectId           String?
  csatScore           Int                        // 1..5
  timelinessScore     Int?                       // 1..5
  clarityScore        Int?                       // 1..5
  supportScore        Int?                       // 1..5
  comment             String?
  isResolvedConfirmed Boolean                    @default(true)
  createdAt           DateTime                   @default(now())

  caseRecord          CommunicationCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([academicYearId, campusId])
  @@index([teacherId])
  @@index([classId, subjectId])
  @@map("communication_satisfaction")
}

model NpsSurveyPeriod {
  id                  String                     @id @default(cuid())
  code                String                     @unique
  title               String
  description         String?
  academicYearId      String
  campusId            String?
  semester            String                     @default("HK1") // HK1, HK2, CA_NAM, DOT_XUAT
  targetScope         String                     @default("ALL") // ALL, GVCN_ONLY, GVBM_ONLY
  minSampleSize       Int                        @default(5)
  status              String                     @default("DRAFT") // DRAFT, PUBLISHED, CLOSED
  startDate           DateTime
  endDate             DateTime
  publishedAt         DateTime?
  createdByUserId     String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  assignments         NpsSurveyAssignment[]
  responses           NpsSurveyResponse[]

  @@index([academicYearId, status])
  @@index([campusId])
  @@map("nps_survey_periods")
}

model NpsSurveyAssignment {
  id                  String                     @id @default(cuid())
  periodId            String
  academicYearId      String
  campusId            String
  classId             String
  teacherId           String
  subjectId           String?
  roleType            String                     // GVCN, GVBM
  sourceAssignmentId  String?
  expectedParentCount Int                        @default(0)
  responseCount       Int                        @default(0)
  isEligibleToPublish Boolean                    @default(false)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  period              NpsSurveyPeriod            @relation(fields: [periodId], references: [id], onDelete: Cascade)
  responses           NpsSurveyResponse[]

  @@unique([periodId, classId, teacherId, roleType, subjectId])
  @@index([periodId, teacherId])
  @@index([academicYearId, campusId, roleType])
  @@map("nps_survey_assignments")
}

model NpsSurveyResponse {
  id                    String                   @id @default(cuid())
  periodId              String
  assignmentId          String
  academicYearId        String
  campusId              String
  classId               String
  teacherId             String
  subjectId             String?
  roleType              String                   // GVCN, GVBM
  parentId              String
  studentId             String
  npsScore              Int                      // 0..10
  npsGroup              String                   // PROMOTER (9-10), PASSIVE (7-8), DETRACTOR (0-6)
  criteriaCommunication Int                      // 1..5 Chất lượng trao đổi
  criteriaTimeliness    Int                      // 1..5 Mức độ kịp thời
  criteriaClarity       Int                      // 1..5 Sự rõ ràng của thông tin
  criteriaSupport       Int                      // 1..5 Mức độ đồng hành, hỗ trợ
  criteriaCoordination  Int                      // 1..5 Hiệu quả phối hợp giáo dục
  criteriaAverage       Float                    // Trung bình 5 tiêu chí 1..5 (tách biệt với NPS)
  feedbackTopic         String?
  comment               String?
  createdAt             DateTime                 @default(now())

  period                NpsSurveyPeriod          @relation(fields: [periodId], references: [id], onDelete: Cascade)
  assignment            NpsSurveyAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([periodId, assignmentId, parentId, studentId])
  @@index([periodId, teacherId, roleType])
  @@index([academicYearId, campusId, classId, subjectId])
  @@map("nps_survey_responses")
}

model QualityImprovementAction {
  id                             String          @id @default(cuid())
  issueCode                      String          @unique
  academicYearId                 String
  campusId                       String
  departmentId                   String?
  classId                        String?
  subjectId                      String?
  teacherId                      String?
