  rsvpStatus           String        @default("PENDING") // PENDING, CONFIRMED, ABSENT, DELEGATED
  attendeeRole         String?       // BO, ME, NGUOI_GIAM_HO, NGUOI_DAI_DIEN, CA_BO_VA_ME
  attendeeName         String?
  attendeePhone        String?
