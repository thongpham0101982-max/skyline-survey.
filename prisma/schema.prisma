model SpecialSubject {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  levels          String   @default("PRIMARY")
  campuses        String   @default("ALL")
  description     String?
  icon            String?  @default("BookOpen")
  color           String?  @default("#00A19A")
  status          String   @default("ACTIVE")
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  legacySubjectId String?
  legacySubject   Subject? @relation(fields: [legacySubjectId], references: [id], onDelete: SetNull)

  curriculums     SpecialCurriculum[]
  assignments     SpecialTeachingAssignment[]

  @@index([status])
  @@index([code])
}

model SpecialCurriculum {
  id               String   @id @default(cuid())
  subjectId        String
  code             String   @unique
  name             String
  level            String
  targetGrades     String
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subject          SpecialSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  versions         SpecialCurriculumVersion[]

  @@index([subjectId])
}

model SpecialCurriculumVersion {
  id               String   @id @default(cuid())
  curriculumId     String
  versionCode      String
  academicYearId   String
  status           String   @default("DRAFT")
  approvedBy       String?
  approvedAt       DateTime?
  description      String?
  sourceDocument   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  curriculum       SpecialCurriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  gradeConfigs     SpecialSubjectGradeConfig[]
  topics           SpecialTopic[]
  lessons          SpecialLesson[]

  @@unique([curriculumId, versionCode])
  @@index([curriculumId])
  @@index([academicYearId])
}

model SpecialSubjectGradeConfig {
  id               String   @id @default(cuid())
  versionId        String
  grade            String
  totalPeriods     Int      @default(15)
  periodMinutes    Int      @default(35)
  overallGoal      String?
  evalCycle        String   @default("PER_LESSON")
  evalScaleType    String   @default("QUALITATIVE_3")
  summaryFormula   String   @default("MOST_FREQUENT")
  isLocked         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  version          SpecialCurriculumVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  criteria         SpecialAssessmentCriterion[]

  @@unique([versionId, grade])
  @@index([versionId])
}

model SpecialTopic {
  id               String   @id @default(cuid())
  versionId        String
  grade            String
  code             String
  name             String
  sortOrder        Int      @default(0)
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  version          SpecialCurriculumVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  lessons          SpecialLesson[]

  @@unique([versionId, grade, code])
  @@index([versionId, grade])
}

model SpecialLesson {
  id                String   @id @default(cuid())
  versionId         String
  topicId           String?
  grade             String
  periodIndex       Int
  lessonName        String
  mainActivities    String?
  objectives        String?
  requirements      String?
  expectedProduct   String?
  isProject         Boolean  @default(false)
  projectMinPeriods Int      @default(1)
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  version           SpecialCurriculumVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  topic             SpecialTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  criteria          SpecialAssessmentCriterion[]
  gradeEntries      SpecialGradeEntry[]
  projectGroups     SpecialProjectGroup[]
  teachingLogs      SpecialTeachingLog[]

  @@unique([versionId, grade, periodIndex])
  @@index([versionId, grade])
  @@index([topicId])
}

model SpecialAssessmentCriterion {
  id               String   @id @default(cuid())
  gradeConfigId    String?
  lessonId         String?
  competencyGroup  String   @default("CHUNG")
  programLevel     String?
  code             String
  name             String
  description      String?
  weight           Float    @default(1.0)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  gradeConfig      SpecialSubjectGradeConfig? @relation(fields: [gradeConfigId], references: [id], onDelete: Cascade)
  lesson           SpecialLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  rubricLevels     SpecialRubricLevel[]

  @@index([gradeConfigId])
  @@index([lessonId])
}

model SpecialRubricLevel {
  id               String   @id @default(cuid())
  criterionId      String
  levelCode        String
  levelName        String
  numericValue     Float?
  description      String
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  criterion        SpecialAssessmentCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([criterionId, levelCode])
  @@index([criterionId])
}

model SpecialTeachingAssignment {
