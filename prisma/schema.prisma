  @@index([meetingId, classId, rsvpStatus])
  @@index([parentId, studentId])
  @@index([parentUserId])
  @@map("parent_meeting_invitations")
}

model ParentMeetingQrSession {
  id                  String        @id @default(cuid())
  tokenHash           String        @unique
  qrToken             String        @unique
  meetingId           String
  classId             String
  studentId           String
  parentId            String
  issuedToUserId      String
