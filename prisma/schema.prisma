  campusId                String
  graduationGrade         String    @default("12")
  graduationYear          Int
  graduationBatch         String?
  educationSystem         String?
  lastClassName           String?
  
  // Trạng thái hiện tại
  currentResidenceCountry String?   @default("Việt Nam")
  currentResidenceCity    String?
  currentAcademicStatus   String?   @default("STUDYING")
  currentCareerStatus     String?   @default("WORKING")
