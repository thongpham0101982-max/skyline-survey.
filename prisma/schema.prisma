model SlcExpertEvaluation {
  id              String    @id @default(cuid())
  periodId        String    @default("GLOBAL")
  targetType      String    // IDEA | PRODUCT
  targetId        String
  expertId        String
  expertName      String
  assignedById    String?
  assignedAt      DateTime  @default(now())
  status          String    @default("ASSIGNED") // ASSIGNED | SUBMITTED | RECUSED
  criterion1Score Float?    // 1..5 (Ý tưởng: Thiết thực | Sản phẩm: Đúng mục đích)
  criterion2Score Float?    // 1..5 (Ý tưởng: Khả thi | Sản phẩm: Dễ sử dụng)
  criterion3Score Float?    // 1..5 (Ý tưởng: Giá trị giáo dục | Sản phẩm: Giá trị ứng dụng)
  averageStars    Float?    // (c1 + c2 + c3) / 3
  comments        String?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([periodId, targetType, targetId, expertId])
  @@index([targetType, targetId, status])
  @@index([expertId, status])
  @@map("slc_expert_evaluations")
}

model SlcAwardRuleSet {
  id                     String   @id @default(cuid())
  code                   String   @unique
  name                   String
  version                Int      @default(1)
  periodType             String   @default("MONTHLY") // MONTHLY | YEARLY
  minRatingsIdea         Int      @default(5)         // Tháng: 5, Năm: 10
  minRatingsProduct      Int      @default(5)         // Tháng: 5, Năm: 10
  minVerifiedAppsProduct Int      @default(3)         // Tháng: 3, Năm: 5
  minExpertReviewers     Int      @default(2)
  bayesianM              Float    @default(5.0)
  bayesianPrior          Float    @default(3.5)
  capVerifiedApps        Int      @default(10)        // Tháng: 10, Năm: 20
  ideaWeightC            Float    @default(0.60)
  ideaWeightE            Float    @default(0.40)
  productWeightC         Float    @default(0.50)
  productWeightE         Float    @default(0.20)
  productWeightU         Float    @default(0.30)
  isLocked               Boolean  @default(false)
  createdById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([periodType, version])
  @@map("slc_award_rule_sets")
}

model SlcAwardPeriod {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  academicYearId      String
  academicYearName    String
  periodType          String               @default("MONTHLY") // MONTHLY | YEARLY
  month               Int?                 // 1..12 for MONTHLY, null for YEARLY
  audienceScope       String               @default("SYSTEM")  // SYSTEM | CAMPUS | GROUP
  audienceScopeId     String               @default("ALL")
  startDateUtc        DateTime             // [startDateUtc, endDateUtc)
  endDateUtc          DateTime
  reviewDeadlineUtc   DateTime
  status              String               @default("DRAFT")   // DRAFT | OPEN | DATA_LOCKED | REVIEWING | FINALIZED
  ruleSetId           String
  ruleSetSnapshotJson String               @default("{}")
  finalizedAt         DateTime?
  finalizedById       String?
  finalizedByName     String?
  lockToken           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  nominations         SlcAwardNomination[]
  snapshots           SlcAwardSnapshot[]

  @@index([academicYearId, periodType, audienceScope, status])
  @@map("slc_award_periods")
}

model SlcAwardNomination {
  id                   String         @id @default(cuid())
  periodId             String
  targetType           String         // IDEA | PRODUCT
  targetId             String
  nominatorId          String
  isReEntry            Boolean        @default(false)
  improvementSummary   String?
  coordinatorConfirmed Boolean        @default(true)
  confirmedById        String?
  confirmedAt          DateTime?
  hasConcludedViolation Boolean       @default(false)
  violationNote        String?
  status               String         @default("REGISTERED") // REGISTERED | ELIGIBLE | INELIGIBLE | DISQUALIFIED
  registeredAt         DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  period               SlcAwardPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("slc_award_nominations")
}

model SlcAwardSnapshot {
  id                     String         @id @default(cuid())
  periodId               String
  snapshotType           String         @default("PROVISIONAL") // PROVISIONAL | REVIEW | OFFICIAL | AMENDMENT
  parentSnapshotId       String?
  amendmentReason        String?
  targetType             String         // IDEA | PRODUCT
  targetId               String
  targetTitle            String
  targetCoverImage       String?
  authorId               String
  authorName             String
  campusId               String?
  campusName             String?
  subjectCodesJson       String         @default("[]")
  gradeLevelsJson        String         @default("[]")
  isEligible             Boolean        @default(false)
  ineligibleReasonsJson  String         @default("[]")
  validRatingCountN      Int            @default(0)
  avgRatingR             Float          @default(0)
  scoreC                 Float          @default(0)
  expertCount            Int            @default(0)
  avgExpertStars         Float?
  scoreE                 Float?
  verifiedAppsCountA     Int            @default(0)
  scoreU                 Float?
  totalScoreRaw          Float?
  rank                   Int?
