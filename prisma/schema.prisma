  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignment       SpecialTeachingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  lesson           SpecialLesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)

