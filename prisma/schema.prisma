// =============================================================================
// API INTEGRATION & EXTERNAL SYSTEM CONNECTION MODELS
// =============================================================================

model ApiApplication {
  id               String         @id @default(cuid())
  name             String
  description      String?
  contactPerson    String?
  status           String         @default("ACTIVE") // ACTIVE, INACTIVE, REVOKED
  permissions      String         @default("[]")     // JSON array: ["students:read", "grades:write", ...]
  allowedCampusIds String         @default("[]")     // JSON array of campus IDs, ["*"] for all
  allowedClassIds  String         @default("[]")     // JSON array of class IDs, ["*"] for all
  allowedDataScope String         @default("ALL")    // "ALL" or custom JSON scope
  expiresAt        DateTime?
  rateLimitRpm     Int            @default(60)       // Max requests per minute
  lastUsedAt       DateTime?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  apiKeys          ApiKey[]
  accessLogs       ApiAccessLog[]

  @@index([status])
  @@map("api_applications")
}

model ApiKey {
  id            String         @id @default(cuid())
  applicationId String
  name          String?        // Human readable label (e.g. "Primary Key 2026")
  keyId         String         @unique // Public identifier, e.g. "kid_..."
  keyPrefix     String         // Masked display prefix, e.g. "sky_live_ab...8f2a"
  keyHash       String         @unique // SHA-256 hash of secret API key
  status        String         @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  application   ApiApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([keyHash])
  @@index([status])
  @@map("api_keys")
}

model ApiAccessLog {
  id             String         @id @default(cuid())
  applicationId  String
  keyId          String?
  requestId      String
  endpoint       String
  method         String
  statusCode     Int
  ipAddress      String?
  userAgent      String?
  durationMs     Int?
  requestSummary String?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  application    ApiApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([requestId])
  @@index([createdAt])
  @@map("api_access_logs")
}

