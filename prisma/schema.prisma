  userId               String
  featureKey           String
  badgeType            String    @default("NEW")
  unreadCount          Int      @default(1)
  title                String?
  lastUpdatedContentAt DateTime @default(now())
  lastViewedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey])
  @@index([userId])
}
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}


// ==========================================
// DANH MỤC NĂNG LỰC & CHUẨN HÓA ALIAS
// ==========================================

model SubjectCompetency {
  id             String                     @id @default(cuid())
  subjectId      String
  code           String
  name           String
  description    String?
  displayOrder   Int                        @default(1)
  weight         Float                      @default(1.0)
  status         String                     @default("ACTIVE")
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  subject        Subject                    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  aliases        SubjectCompetencyAlias[]
  assessments    StudentCompetencyAssessment[]
  stagingItems   StagingCompetencyAssessment[]

  @@unique([subjectId, code])
  @@index([subjectId])
}

model SubjectAlias {
  id             String   @id @default(cuid())
  subjectId      String
  aliasPattern   String
  normalizedKey  String
  createdAt      DateTime @default(now())

  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([aliasPattern])
  @@index([normalizedKey])
}

model SubjectCompetencyAlias {
  id             String            @id @default(cuid())
  competencyId   String
  aliasPattern   String
  normalizedKey  String
  createdAt      DateTime          @default(now())

  competency     SubjectCompetency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@unique([aliasPattern])
  @@index([normalizedKey])
}

// ==========================================
// LỊCH SỬ BATCH IMPORT & CẤU HÌNH MAPPING
// ==========================================

model ImportBatch {
  id               String                        @id @default(cuid())
  batchCode        String                        @unique
  fileName         String
  fileSize         Int
  fileHash         String
  academicYearId   String
  semester         Int                           @default(1)
  assessmentPeriod String                        @default("GIUA_KY_1")
  importedById     String
  status           String                        @default("STAGED")
  totalRows        Int                           @default(0)
  validRows        Int                           @default(0)
  warningRows      Int                           @default(0)
  errorRows        Int                           @default(0)
  duplicateRows    Int                           @default(0)
  errorSummary     String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  academicYear     AcademicYear                  @relation(fields: [academicYearId], references: [id])
  importedBy       User                          @relation(fields: [importedById], references: [id])
  stagingRecords   StagingCompetencyAssessment[]
  finalRecords     StudentCompetencyAssessment[]

  @@index([academicYearId])
  @@index([importedById])
  @@index([fileHash])
}

model ImportMappingConfig {
  id             String   @id @default(cuid())
  name           String
  headerMapping  String
  isDefault      Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ==========================================
// STAGING TABLE (BẢNG TRUNG GIAN)
// ==========================================

model StagingCompetencyAssessment {
  id                 String             @id @default(cuid())
  batchId            String
  rowNumber          Int
  
  rawYear            String?
  rawStudentCode     String?
  rawStudentName     String?
  rawClass           String?
  rawSubject         String?
  rawCompetency      String?
  rawAchievedScore   String?
  rawMaxScore        String?
  rawRadarPercent    String?

  studentId          String?
  subjectId          String?
  competencyId       String?
  
  achievedScore      Float?
  maxScore           Float?
  competencyPercent  Float?
  calculationSource  String?

  validationStatus   String             @default("PENDING")
  errorMessages      String?

  batch              ImportBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  competency         SubjectCompetency? @relation(fields: [competencyId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([validationStatus])
  @@index([studentId])
}

// ==========================================
// BẢNG DỮ LIỆU ĐÁNH GIÁ CHÍNH THỨC
// ==========================================

model StudentCompetencyAssessment {
  id                 String            @id @default(cuid())
  batchId            String
  studentId          String
  subjectId          String
  competencyId       String
  academicYearId     String
  semester           Int               @default(1)
  assessmentPeriod   String

  achievedScore      Float?
  maxScore           Float?
  competencyPercent  Float
  weight             Float             @default(1.0)
  calculationSource  String            @default("SYSTEM_CALCULATED")
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  batch              ImportBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student            Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject            Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  competency         SubjectCompetency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, studentId, subjectId, competencyId, assessmentPeriod], name: "unique_competency_assessment_entry")
  @@index([studentId, academicYearId, assessmentPeriod])
  @@index([subjectId, academicYearId])
  @@index([batchId])
}

// ==========================================
// BẢNG TỔNG HỢP MÔN HỌC (CACHE/SUMMARY)
// ==========================================

model StudentSubjectCompetencySummary {
  id                 String       @id @default(cuid())
  studentId          String
  subjectId          String
  academicYearId     String
  semester           Int          @default(1)
  assessmentPeriod   String
  
  subjectScore       Float?
  evaluatedCount     Int          @default(0)
  totalCompetencies  Int          @default(0)
  radarData          String
  updatedAt          DateTime     @updatedAt

  student            Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject            Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, studentId, subjectId, assessmentPeriod])
  @@index([studentId, academicYearId])
}


model StudentGoalUnlock {
  id                  String       @id @default(cuid())
  goalId              String
  studentId           String
  academicYearId      String
  
  targetCategory      String       // HOC_TAP, THOI_QUEN, KY_NANG_CAM_XUC, DINH_HUONG
  targetText          String       // Noi dung muc tieu duoc chon mo khoa tu GD1
  
  currentState        String       // STILL_COMMITTED, STALLED, NOT_STARTED
  barriers            String       // JSON string of selected barriers array
  otherBarrier        String?      // Noi dung nhap khi chon "Khac"
  
  selectedKey         String       // FIND_REASON, CHANGE_METHOD, START_SMALL, FIND_COMPANION, ADJUST_GOAL
  
  sevenDayAction      String       // Viec nho se thu trong 7 ngay toi
  actionTiming        String?      // Buoi sang, Sau gio hoc, Buoi toi, Cuoi tuan, Khac
  companion           String?      // Toi tu thuc hien, Ban be, Co van hoc tap/GVCN, Giao vien bo mon, Ba me, Khac
  
  needSupport         Boolean      @default(false)
  supportStatus       String       @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  teacherSupportNotes String?      // Nhan xet, ho tro tu GVCN / CVHT
  
  startDate           DateTime     @default(now())
  endDate             DateTime
  status              String       @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  completedAt         DateTime?
  
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  goal                StudentGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  student             Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([goalId])
  @@index([academicYearId])
  @@index([status])
}

// ============================================================================
