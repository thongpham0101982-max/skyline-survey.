  signingFlowRules       String   @default("{\"order\":[\"GVBM\",\"GVCN\",\"TTCM\",\"GDCS\"],\"requirePreviousSigns\":true}")
  anchorSettings         String   @default("{}")
  campusScope            String   @default("[\"*\"]")
  academicYearScope      String   @default("[\"*\"]")
  autoPublishOnCompleted Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([key])
  @@map("digital_signature_configs")
}

model SignableDocument {
  id                String              @id @default(cuid())
  documentCode      String              @unique // DOC-HSNL-2026-HS001-v1
  formType          String              // HO_SO_NANG_LUC, PHIEU_DANH_GIA_MON_HOC, PHIEU_DANH_GIA_MAM_NON, CAM_KET_HOC_TAP
  studentId         String
  academicYearId    String
  classId           String
  campusId          String?
  subjectId         String?             // For subject-specific evaluations
  term              String?             // GK1, CK1, GK2, CK2, FULL_YEAR
  title             String
  version           String              @default("1.0")
  versionNumber     Int                 @default(1)
  contentHash       String              // SHA-256 of snapshot
  contentSnapshot   String              // JSON snapshot
  contentStatus     String              @default("READY_TO_SIGN") // DRAFT, NOT_ELIGIBLE, READY_TO_SIGN, REVISION_REQUIRED
  publicationStatus String              @default("UNPUBLISHED")  // UNPUBLISHED, PUBLISHED, SUPERSEDED
  publishedAt       DateTime?
  publishedById     String?
  isCompleted       Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class             Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  signatures        DocumentSignature[]

  @@index([studentId])
  @@index([classId])
  @@index([academicYearId])
  @@index([subjectId])
  @@index([formType])
  @@index([contentStatus, publicationStatus])
  @@map("signable_documents")
}

model DocumentSignature {
  id                   String           @id @default(cuid())
  documentId           String
  signerId             String
  signerName           String
  signerRole           String           // GVBM, GVCN, TTCM, GDCS, ADMIN
  orderIndex           Int              @default(1)
  requestStatus        String           @default("AWAITING_AUTH") // AWAITING_AUTH, PROCESSING, SUCCESS, FAILED, CANCELLED, UNKNOWN_PENDING_RECONCILE
  requestId            String           @unique // REQ-SIG-...
  transactionId        String?
  provider             String
  dataHash             String           // SHA-256 of signed data
  signatureValue       String?
  certificateSerial    String?
  certificateSubject   String?
  certIssuer           String?
  signedAt             DateTime?
  verifiedAt           DateTime?
  verificationResult   String?          // JSON
  visualAppearanceUrl  String?
  signedPdfPath        String?
  failureReason        String?
  retryCount           Int              @default(0)
  reconciliationStatus String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  document             SignableDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([signerId])
  @@index([requestStatus])
  @@index([requestId])
  @@map("document_signatures")
}

model SignatureAuditLog {
  id          String   @id @default(cuid())
  documentId  String?
  signatureId String?
  action      String   // CONNECT_PROVIDER, UPDATE_APPEARANCE, REQUEST_SIGN, VERIFY_SIGN, BATCH_SIGN, RECONCILE, REVISION_TRIGGERED, PUBLISH, DOWNLOAD_PDF
  actorId     String
