  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([academicYearId])
}

model StudentHelpRequest {
  id             String   @id @default(cuid())
  studentId      String
  academicYearId String
  teacherId      String?  // GVCN / CVHT tiep nhan
  
  category       String   @default("HOC_TAP") // "HOC_TAP", "TAM_LY_BAN_BE", "SUC_KHOE", "KHAC"
  content        String   // Noi dung can ho tro
  urgency        String   @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  status         String   @default("PENDING") // "PENDING", "PROCESSING", "RESOLVED"
  
  responseNotes  String?  // Phan hoi tu GVCN
  resolvedAt     DateTime?
  
