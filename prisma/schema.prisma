  @@unique([followerId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([followerId])
  @@map("slc_follows")
}

model SlcRating {
  id                   String              @id @default(cuid())
  targetType           String              // IDEA | PRODUCT
  targetId             String
  reviewerId           String
  reviewerName         String
  reviewerCampusId     String?
  stars                Int                 // 1..5
  starLabel            String?
  criteriaTagsJson     String              @default("[]") // Tiết kiệm thời gian | Dễ sử dụng | Hỗ trợ bài dạy | Thu hút HS | Cần cải tiến
  reviewText           String?
  confirmedExperienced Boolean             @default(false)
  productVersion       String?
  majorVersion         Int                 @default(1)
  isValid              Boolean             @default(true)
  invalidReason        String?
  invalidatedAt        DateTime?
