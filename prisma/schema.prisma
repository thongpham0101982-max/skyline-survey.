  lastRevisedAt        DateTime            @default(now())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  revisions            SlcRatingRevision[]

  @@unique([targetType, targetId, reviewerId])
  @@index([targetType, targetId, isValid])
  @@index([reviewerId])
  @@map("slc_ratings")
}

model SlcRatingRevision {
  id                   String    @id @default(cuid())
  ratingId             String
  targetType           String    // IDEA | PRODUCT
  targetId             String
  reviewerId           String
  reviewerName         String?
