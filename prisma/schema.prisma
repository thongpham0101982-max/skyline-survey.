// ==========================================
// Co Van Hoc Tap & Ho So Hoc Sinh 360
// ==========================================

model StudentGoal {
  id             String   @id @default(cuid())
  studentId      String
  academicYearId String
  semester       String   @default("CA_NAM") // "HK1", "HK2", "CA_NAM"
  gradeLevel     String   // "K1", "K2", "K3", "K4", "K5", "K6", "K7", "K8", "K9", "K10", "K11", "K12"
  category       String   // "HOC_TAP", "THOI_QUEN_SUC_KHOE", "KY_NANG_SO_THICH", "PHAM_CHAT", "DINH_HUONG"
  
  targetText     String   // Muc tieu cua em
  presetId       String?  // Id preset neu co cho K1-K3
  
  // Cot ho tro cho K6-K8 va K9-K12
  teacherSupportRequest String? // Em mong muon thay co/ban be ho tro minh nhu the nao?
  parentSupportRequest  String? // Em mong muon ba me ho tro minh nhu the nao?
  
  // SMART fields cho K9-K12
  smartSpecific   String?
  smartMeasurable String?
  smartAchievable String?
  smartRelevant   String?
  smartTimeBound  String?
  
  checkpointDate   DateTime?
  achievementLevel String?   @default("DANG_TIEN_TRIEN") // "DAT", "DANG_TIEN_TRIEN", "CHUA_DAT"
  status           String    @default("IN_PROGRESS") // "NOT_STARTED", "IN_PROGRESS", "COMPLETED", "PARTIAL"
  
  studentCommitment String?  // Loi cam ket cua em
  parentMessage     String?  // Loi nhan gui cua Phu huynh
  teacherComment    String?  // Nhan xet cua GVCN / CVHT
  
  signedByStudent Boolean   @default(false)
  signedByParent  Boolean   @default(false)
  signedByTeacher Boolean   @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  actions      StudentGoalAction[]
  unlocks      StudentGoalUnlock[]

  @@index([studentId])
  @@index([academicYearId])
  @@index([gradeLevel])
}

model StudentGoalAction {
  id         String   @id @default(cuid())
  goalId     String
  actionText String   // Em se lam gi de dat duoc?
  status     String   @default("PENDING") // "PENDING", "COMPLETED"
  deadline   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  goal StudentGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model AcademicConsultationLog {
  id             String   @id @default(cuid())
  studentId      String
  teacherId      String
  academicYearId String
  meetingDate    DateTime @default(now())
  
  content        String   // Noi dung trao doi
  difficulties   String?  // Kho khan ghi nhan
  nextActions    String?  // Hanh dong tiep theo
  deadline       DateTime? // Thoi han
  notes          String?  // Ghi chu
  studentReflection String? // Tu danh gia sau buoi co van tu hoc sinh
  status         String   @default("COMPLETED") // "PENDING", "COMPLETED"
  subjectId      String?
  textbookId     String?
  chapterId      String?
  lessonId       String?
  academicTopic  String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

