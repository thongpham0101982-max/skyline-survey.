  target        LearningSupportTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  evaluatorId   String
  periodType    String // "WEEK" or "MONTH"
  periodName    String
  trackingLevel String
  comment       String
  updatedStatus String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([targetId])
}
