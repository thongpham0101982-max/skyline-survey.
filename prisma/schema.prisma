  studentNeedsSupport      String?  // Điểm cần hỗ trợ ban đầu
  interviewerGeneralRemark String?  // Nhận xét tổng quan của GV phỏng vấn

  // Tab 2 – Trao đổi PHHS
  parentExpectations       String?  // Nguyện vọng, kỳ vọng của gia đình
  parentHealthNotes        String?  // Lưu ý về sức khỏe, dinh dưỡng, dị ứng
  parentPersonalityNotes   String?  // Thói quen, tính cách ở nhà do PH cung cấp
  parentSpecialRequests    String?  // Đề xuất, mong muốn hỗ trợ đặc biệt
  cooperationCommitment    String?  // Nội dung cam kết phối hợp giáo dục
  parentRepresentativeName String?  // Người đại diện PHHS trao đổi
  parentPhone              String?  // Số điện thoại PHHS

  // Tổng hợp định hướng của Hội đồng tiếp nhận
  proposedEduSystem        String?  // Đề xuất Hệ đào tạo (Hội nhập, Quốc tế, Song ngữ...)
  proposedClassPlacement   String?  // Đề xuất phân lớp
  admissionConsultantNote  String?  // Ý kiến của Tư vấn tuyển sinh / BGH

